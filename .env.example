# PostgreSQL
POSTGRES_USER=cryptoscan
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=cryptoscan

# API Security
SECRET_KEY=change_me_to_random_64_char_string_in_production
SESSION_EXPIRE_HOURS=24

# GitHub Integration
GITHUB_WEBHOOK_SECRET=change_me_to_random_secret
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Email Alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=cryptoscan-alerts@yourcompany.com
ALERT_EMAIL_TO=security-team@yourcompany.com

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Redis
REDIS_URL=redis://localhost:6379/0

# Database URL (for direct connection)
DATABASE_URL=postgresql://cryptoscan:change_me_in_production@localhost:5432/cryptoscan