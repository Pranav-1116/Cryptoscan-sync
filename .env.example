# =============================================================================
# CryptoScan ONLY — do not copy this file into another repo.
# Host ports below are offset so a second stack (Postgres 5432, Redis 6379,
# Neo4j 7687, HTTP 80/8010) can stay running on the same laptop.
# =============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
CRYPTOSCAN_ROOT=

# --- Local process (bash scripts/run_stack.sh) ---
# SQLite + empty Redis/Neo4j = no shared daemons, zero collision.
DATABASE_URL=sqlite:///./data/cryptoscan.db
ALLOW_SQLITE=true
REDIS_URL=
NEO4J_URI=

# --- Docker Compose host publish ports (docker compose up) ---
POSTGRES_PORT=55432
REDIS_PORT=56379
NEO4J_HTTP_PORT=57474
NEO4J_BOLT_PORT=57687
NGINX_PORT=8088
FRONTEND_PORT=3003
API_HOST=0.0.0.0
API_PORT=8010

# --- If you attach the API on the host to Compose-published ports ---
# DATABASE_URL=postgresql://cryptoscan:cryptoscan_secret@127.0.0.1:55432/cryptoscan
# REDIS_URL=redis://127.0.0.1:56379/0
# NEO4J_URI=bolt://127.0.0.1:57687

POSTGRES_USER=cryptoscan
POSTGRES_PASSWORD=cryptoscan_secret
POSTGRES_DB=cryptoscan
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=cryptoscan
DB_USER=cryptoscan
DB_PASSWORD=cryptoscan_secret

SCAN_JOB_QUEUE_KEY=cryptoscan:jobs:queue

SECRET_KEY=dev-cryptoscan-secret-key-change-in-production-32
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=false

ADMIN_USERNAME=admin
ADMIN_PASSWORD=cryptoscan
ADMIN_PASSWORD_HASH=

LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_SECONDS=900

GITHUB_WEBHOOK_SECRET=dev-webhook-secret-change-me-32chars!!
GITHUB_TOKEN=
GH_TOKEN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@cryptoscan.local
ALERT_EMAIL_TO=security@example.com
CRYPTOSCAN_SMTP_HOST=
CRYPTOSCAN_ALERT_P0=1

CORS_ORIGINS=*
ALLOW_INSECURE_CORS=false
# Optional for local development; required in production. Prometheus uses it
# as a bearer token when scraping /metrics.
METRICS_TOKEN=
DOCS_ENABLED=true

WORKSPACE_BASE_PATH=./data/workspaces
CLEANUP_WORKSPACE=true
CLONE_TIMEOUT_SECONDS=300
SCAN_TIMEOUT_SECONDS=600
MAX_CONCURRENT_JOBS=2

CRYPTOSCAN_CVE_LIVE=0
CRYPTOSCAN_GITHUB_ADVISORY=0
CRYPTOSCAN_CVE_TIMEOUT=8
NVD_API_KEY=
OSV_API_URL=https://api.osv.dev
CRYPTOSCAN_CONTAINER_PULL_TIMEOUT=120
CRYPTOSCAN_CONTAINER_WORKSPACE=
CRYPTOSCAN_CBOM_SECRET=
CRYPTOSCAN_CBOM_SIGN=0
CRYPTOSCAN_CBOM_SPEC=1.5
CRYPTOSCAN_API_URL=
CRYPTOSCAN_API=http://127.0.0.1:8010
CRYPTOSCAN_TOKEN=
DASHBOARD_URL=http://127.0.0.1:3003

CRYPTOSCAN_TLS_LIVE=0
CRYPTOSCAN_TLS_TIMEOUT=5
CRYPTOSCAN_TLS_EXPIRY_DAYS=30
CRYPTOSCAN_CLOUD_LIVE=0
CRYPTOSCAN_CLOUD_SUBMIT=0
CRYPTOSCAN_CLOUD_REGIONS=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GCP_PROJECT=

NEO4J_USER=neo4j
NEO4J_PASSWORD=cryptoscan
NEO4J_DATABASE=neo4j
ISTIO_PROMETHEUS_URL=

CRYPTOSCAN_DEDUP_WINDOW=3
CRYPTOSCAN_DEDUP_CROSS_SCANNER=1
CRYPTOSCAN_EXEC_REVENUE_THRESHOLD=1000000

# Static source-parser boundary only (see docs/dev/scanner-isolation.md).
# Blank mode selects inline in development/test, container in production.
# Production refuses inline and requires a preloaded, digest-pinned image.
# A Docker CLI/approved daemon and same-path shared staging are additional
# prerequisites; these variables alone do not provision an isolated runtime.
CRYPTOSCAN_STATIC_SCAN_MODE=
CRYPTOSCAN_SCANNER_IMAGE=
CRYPTOSCAN_STATIC_SCAN_TIMEOUT_S=600

# Optional dedicated notification scheduler (Compose profile: notifications).
# OFF until explicitly enabled AND estates selected; no SMTP or automatic opt-in.
# Tenant IDs must be a JSON list of registered active tenant UUIDs. Region must
# match declared processing_regions (or data_residency_region when unspecified).
NOTIFICATION_DISPATCH_ENABLED=false
NOTIFICATION_DISPATCH_PLATFORM=false
NOTIFICATION_DISPATCH_TENANTS=[]
NOTIFICATION_DISPATCH_REGION=
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=30
NOTIFICATION_DISPATCH_BUDGET_SECONDS=20
NOTIFICATION_DISPATCH_SCOPE_BUDGET_SECONDS=5
NOTIFICATION_DISPATCH_MAX_SCOPES=10
NOTIFICATION_DISPATCH_LIMIT=50

# Controlled local-source execution: REQUIRED in production (cannot opt out).
# Export CRYPTOSCAN_EXECUTION_CONTROLS=true to qualify the profile in dev/test.
# Read docs/runbooks/controlled-execution-upgrade.md BEFORE enabling: unreviewed
# APIs/monitor/WebSocket/collector paths are refused, not silently downgraded.
# Bindings are operator declarations, not physical-residency certification.
CRYPTOSCAN_EXECUTION_CONTROLS=false
CRYPTOSCAN_EXECUTION_REGION=
CRYPTOSCAN_EVIDENCE_REGION=
CRYPTOSCAN_EVIDENCE_DESTINATION=
