# CryptoScan environment
# Copy to .env and change secrets before any real deployment.

ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite for local / demo. Production: postgresql+psycopg2://user:pass@postgres:5432/cryptoscan
DATABASE_URL=sqlite:///./data/cryptoscan.db

# Leave empty to run jobs in-process (no Redis). Production: redis://redis:6379/0
REDIS_URL=
SCAN_JOB_QUEUE_KEY=cryptoscan:jobs:queue

# MUST be at least 32 characters
SECRET_KEY=change-me-to-a-random-64-character-secret-key-please
SESSION_EXPIRE_HOURS=24

ADMIN_USERNAME=admin
ADMIN_PASSWORD=cryptoscan

# GitHub
GITHUB_WEBHOOK_SECRET=change-me-to-a-random-webhook-secret-32ch
GITHUB_TOKEN=

# Email (optional — drift alerts log if SMTP unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@cryptoscan.local
ALERT_EMAIL_TO=security@example.com

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Worker
WORKSPACE_BASE_PATH=./data/workspaces
CLEANUP_WORKSPACE=true

# Live CVE lookup (OSV always; NVD only with a key). Off by default so tests stay offline.
CRYPTOSCAN_CVE_LIVE=0
NVD_API_KEY=
OSV_API_URL=https://api.osv.dev
CRYPTOSCAN_CONTAINER_PULL_TIMEOUT=120

# Live TLS probes and live cloud APIs stay off unless explicitly enabled.
CRYPTOSCAN_TLS_LIVE=0
CRYPTOSCAN_CLOUD_LIVE=0

# Neo4j (optional). Empty URI keeps the in-process graph. Compose default:
# NEO4J_URI=bolt://neo4j:7687
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=cryptoscan
NEO4J_DATABASE=neo4j
ISTIO_PROMETHEUS_URL=
