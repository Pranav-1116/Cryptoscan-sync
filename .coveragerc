# Coverage configuration (round 17 — report 16).
#
# Coverage is OPT-IN, never a default test-run behavior: the gate is the
# suite result, not a percentage. Use scripts/coverage.sh for a per-service
# report; CI wiring remains blocked by the standing no-workflows constraint
# (staged in .github/workflows-pending/).
[run]
branch = True
# importable package names (not paths) so one config works from any service dir
source =
    api
    worker
    scanner
    db
    policy
    cbom
    evidence
    shared_models
parallel = True
# concurrency events make SQLite-backed unit runs flap; measure the code, not the harness
concurrency = thread
disable_warnings =
    module-not-imported
    no-data-collected

[report]
show_missing = False
skip_covered = False
precision = 1
exclude_lines =
    pragma: no cover
    def __repr__
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:
    @abstractmethod

[html]
directory = coverage-html
