# payments-bastion — legacy jump host. OpenSSH 9.x runs this fine; the
# "+..." lines re-enable algorithms a modern baseline disables, which is
# exactly what the scanner is supposed to flag.
Port 22
ListenAddress 0.0.0.0
Protocol 2

HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# Legacy posture on purpose:
KexAlgorithms +diffie-hellman-group14-sha1,diffie-hellman-group-exchange-sha1
HostKeyAlgorithms +ssh-rsa
PubkeyAcceptedAlgorithms +ssh-rsa
Ciphers +aes128-cbc,aes256-cbc
MACs +hmac-sha1,hmac-sha1-96,umac-64@openssh.com

PasswordAuthentication no
PermitRootLogin no
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
Banner /etc/ssh/banner.txt
Subsystem sftp internal-sftp
