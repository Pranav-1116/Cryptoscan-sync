# CryptoScan PoC environment — copy to poc.env and fill in.
#   cp poc.env.example poc.env
# Everything optional stays empty = feature off (honest, never half-on).

# ── required ────────────────────────────────────────────────────────────
# Session/HMAC secret — generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Bootstrap platform-owner password — change from the default BEFORE day 1.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── optional: SSO (corporate IdP; see docs/enterprise-readiness.md §1) ──
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── optional: ITSM/SIEM delivery (see docs/enterprise-readiness.md §3) ──
SERVICENOW_INSTANCE_URL=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
SENTINEL_WORKSPACE_ID=
SENTINEL_SHARED_KEY=

# ── ports / paths ───────────────────────────────────────────────────────
API_PORT=8080
DASHBOARD_PORT=3000
# Host path to the telecom registry seed (may not exist for non-telecom PoCs)
TELECOM_REGISTRY_HOST_PATH=./telecom_registry.json
