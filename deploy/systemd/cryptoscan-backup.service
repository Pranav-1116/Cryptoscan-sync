[Unit]
Description=CryptoScan database backup (postgres + optional neo4j, sha256 manifest, retention)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Run from the repo checkout that carries docker-compose.prod.yml.
WorkingDirectory=/opt/cryptoscan
ExecStart=/usr/bin/env bash scripts/db_backup.sh
# Offsite copy hook — replace with your object-storage sync (a backup that
# stays on the same host is not a backup).
# ExecStartPost=/usr/local/bin/rclone copy /opt/cryptoscan/backups/db remote:cryptoscan-backups
Nice=10
