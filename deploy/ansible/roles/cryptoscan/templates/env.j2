# CryptoScan installation configuration — Ansible-managed. Secrets live in
# {{ cryptoscan_root }}/secrets and are referenced by *_FILE, never valued
# here (the secrets manager resolves them; see docs/admin-guide/infrastructure.md).
POSTGRES_USER=cryptoscan
POSTGRES_DB=cryptoscan
POSTGRES_PASSWORD_FILE={{ cryptoscan_root }}/secrets/db_password
VAULT_TOKEN_FILE={{ cryptoscan_root }}/secrets/vault_token
POSTGRES_HOST=db
API_PORT=8010
RELEASE_CHANNEL={{ cryptoscan_profile }}
