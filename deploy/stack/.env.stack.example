# Stack profile environment — COPY to .env and fill in. Secrets live in
# the bank's secret manager (Vault path secret/data/cryptoscan/*); this
# file records NAMES, never values, and is safe to commit.
POSTGRES_DB=cryptoscan
POSTGRES_USER=cryptoscan
POSTGRES_PASSWORD=           # set from the secret manager — never commit
NEO4J_USER=neo4j
NEO4J_PASSWORD=              # set from the secret manager — never commit
MINIO_ROOT_USER=cryptoscan
MINIO_ROOT_PASSWORD=         # set from the secret manager — never commit
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=      # set from the secret manager — never commit
VAULT_DEV_ROOT_TOKEN_ID=     # dev profile only — production unseals + bank IAM
KAFKA_LOG_RETENTION_HOURS=168

# Runtime endpoints the platform reads (stack_settings probes these):
DATABASE_URL=postgresql+psycopg2://cryptoscan@postgres:5432/cryptoscan
NEO4J_URI=bolt://neo4j:7687
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MINIO_ENDPOINT=minio:9000
OPENSEARCH_URL=http://opensearch:9200
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
VAULT_ADDR=http://vault:8200
ENVOY_ADMIN_URL=http://envoy:9901
OIDC_ISSUER_URL=             # the bank's IdP issuer — register, never invent
