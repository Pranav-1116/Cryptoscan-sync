# DEVELOPMENT-ONLY stack profile. Copy to a private .env and fill in.
# Requires Docker Compose >=2.24; `make stack-up` runs a refusal preflight.
# Internal Kafka/Redis/OpenSearch/MinIO endpoints are plaintext, OpenSearch
# security is disabled, and Vault is ephemeral dev mode. NOT for production.
# Secrets live in the operator's secret manager, never in this file.
ENVIRONMENT=development
STACK_DEV_ACK=                  # set development-only explicitly
GATEWAY_TLS_CERT_DIR=           # absolute external dir containing tls.crt/tls.key
POSTGRES_DB=cryptoscan
POSTGRES_USER=cryptoscan
POSTGRES_PASSWORD=           # set from the secret manager — never commit
NEO4J_USER=neo4j
NEO4J_PASSWORD=              # set from the secret manager — never commit
MINIO_ROOT_USER=cryptoscan
MINIO_ROOT_PASSWORD=         # set from the secret manager — never commit
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=      # set from the secret manager — never commit
VAULT_DEV_ROOT_TOKEN_ID=     # dev profile only — production unseals + bank IAM
KAFKA_LOG_RETENTION_HOURS=168

# Runtime endpoints the platform reads (stack_settings probes these):
DATABASE_URL=postgresql+psycopg2://cryptoscan@postgres:5432/cryptoscan
NEO4J_URI=bolt://neo4j:7687
REDIS_URL=redis://redis:6379/0
# The app worker/outbox uses REDIS_URL; this profile does not run Celery.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
MINIO_ENDPOINT=minio:9000
OPENSEARCH_URL=http://opensearch:9200
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
VAULT_ADDR=http://vault:8200
# Envoy admin binds only to 127.0.0.1 *inside* its container; it is
# intentionally not exposed to this stack's other services or host probe.
ENVOY_ADMIN_URL=
OIDC_ISSUER_URL=             # the bank's IdP issuer — register, never invent
