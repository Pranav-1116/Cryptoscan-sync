{
  "$defs": {
    "ExpectedPackage": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Version"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ExpectedPackage",
      "type": "object"
    },
    "ExpectedSoftwareInput": {
      "additionalProperties": false,
      "properties": {
        "expected_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Content Sha256",
          "type": "string"
        },
        "input_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Input Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "DPKG_STATUS",
            "APK_INSTALLED",
            "RPM_SQLITE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/ExpectedPackage"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "input_id",
        "kind",
        "expected_content_sha256",
        "records"
      ],
      "title": "ExpectedSoftwareInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "inputs": {
      "items": {
        "$ref": "#/$defs/ExpectedSoftwareInput"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "reviewer_reference": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Reviewer Reference",
      "type": "string"
    },
    "schema_version": {
      "const": "cryptoscan.software-truth-plan/v1",
      "default": "cryptoscan.software-truth-plan/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "truth_basis": {
      "const": "OPERATOR_SUPPLIED_EXPECTED_REGISTER_NOT_INDEPENDENTLY_AUTHENTICATED",
      "default": "OPERATOR_SUPPLIED_EXPECTED_REGISTER_NOT_INDEPENDENTLY_AUTHENTICATED",
      "title": "Truth Basis",
      "type": "string"
    }
  },
  "required": [
    "manifest_sha256",
    "reviewer_reference",
    "inputs"
  ],
  "title": "SoftwareTruthPlan",
  "type": "object"
}
