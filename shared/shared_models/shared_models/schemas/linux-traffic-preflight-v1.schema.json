{
  "$defs": {
    "LinkReading": {
      "additionalProperties": false,
      "properties": {
        "ifindex": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ifindex"
        },
        "interface": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,14}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface"
        },
        "kind": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9_-]{1,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "status": {
          "enum": [
            "MEASURED",
            "UNAVAILABLE",
            "DENIED",
            "INVALID"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "LinkReading",
      "type": "object"
    },
    "PreflightSpec": {
      "additionalProperties": false,
      "properties": {
        "authorizes_real_host_change": {
          "const": false,
          "default": false,
          "title": "Authorizes Real Host Change",
          "type": "boolean"
        },
        "egress_limit_mbps": {
          "maximum": 100000,
          "minimum": 1,
          "title": "Egress Limit Mbps",
          "type": "integer"
        },
        "expected_boot_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Expected Boot Id",
          "type": "string"
        },
        "expected_ifindex": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Expected Ifindex",
          "type": "integer"
        },
        "expected_mount_namespace_inode": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Expected Mount Namespace Inode",
          "type": "integer"
        },
        "expected_network_namespace_inode": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Expected Network Namespace Inode",
          "type": "integer"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "host_label": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Host Label",
          "type": "string"
        },
        "interface": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,14}$",
          "title": "Interface",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "management_ips": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Management Ips",
          "type": "array"
        },
        "nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Nonce",
          "type": "string"
        },
        "proposal_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Proposal Id",
          "type": "string"
        },
        "proposal_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Proposal Record Sha256",
          "type": "string"
        },
        "read_only": {
          "const": true,
          "default": true,
          "title": "Read Only",
          "type": "boolean"
        },
        "request_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "cryptoscan.linux-traffic-preflight-spec/v1",
          "default": "cryptoscan.linux-traffic-preflight-spec/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_capture_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Capture Sha256",
          "type": "string"
        },
        "system_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "System Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "proposal_id",
        "proposal_record_sha256",
        "source_capture_sha256",
        "nonce",
        "system_id",
        "host_label",
        "interface",
        "expected_ifindex",
        "expected_boot_id",
        "expected_network_namespace_inode",
        "expected_mount_namespace_inode",
        "egress_limit_mbps",
        "management_ips",
        "issued_at",
        "expires_at"
      ],
      "title": "PreflightSpec",
      "type": "object"
    },
    "Qdisc": {
      "additionalProperties": false,
      "properties": {
        "handle": {
          "pattern": "^[0-9a-f]{1,4}:[0-9a-f]{0,4}$",
          "title": "Handle",
          "type": "string"
        },
        "kind": {
          "pattern": "^[a-zA-Z0-9_-]{1,40}$",
          "title": "Kind",
          "type": "string"
        },
        "options_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Options Sha256",
          "type": "string"
        },
        "root": {
          "title": "Root",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "handle",
        "root",
        "options_sha256"
      ],
      "title": "Qdisc",
      "type": "object"
    },
    "QdiscReading": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/Qdisc"
          },
          "maxItems": 32,
          "title": "Entries",
          "type": "array"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "status": {
          "enum": [
            "MEASURED",
            "UNAVAILABLE",
            "DENIED",
            "INVALID"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "QdiscReading",
      "type": "object"
    },
    "RouteReading": {
      "additionalProperties": false,
      "properties": {
        "destination": {
          "maxLength": 45,
          "title": "Destination",
          "type": "string"
        },
        "interface": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,14}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface"
        },
        "source_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "status": {
          "enum": [
            "MEASURED",
            "UNAVAILABLE",
            "DENIED",
            "INVALID"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "destination",
        "status"
      ],
      "title": "RouteReading",
      "type": "object"
    },
    "ToolPin": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "tool": {
          "enum": [
            "ip",
            "tc"
          ],
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "sha256"
      ],
      "title": "ToolPin",
      "type": "object"
    }
  },
  "$id": "https://cryptoscan.local/schemas/linux-traffic-preflight-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "boot_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Boot Id",
      "type": "string"
    },
    "configuration_changed": {
      "const": false,
      "default": false,
      "title": "Configuration Changed",
      "type": "boolean"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "link": {
      "$ref": "#/$defs/LinkReading"
    },
    "mount_namespace_inode": {
      "maximum": 18446744073709551615,
      "minimum": 1,
      "title": "Mount Namespace Inode",
      "type": "integer"
    },
    "network_namespace_inode": {
      "maximum": 18446744073709551615,
      "minimum": 1,
      "title": "Network Namespace Inode",
      "type": "integer"
    },
    "provenance": {
      "const": "IMPORTED",
      "default": "IMPORTED",
      "title": "Provenance",
      "type": "string"
    },
    "qdiscs": {
      "$ref": "#/$defs/QdiscReading"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/RouteReading"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Routes",
      "type": "array"
    },
    "schema_version": {
      "const": "cryptoscan.linux-traffic-preflight/v1",
      "default": "cryptoscan.linux-traffic-preflight/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_authenticity_verified": {
      "const": false,
      "default": false,
      "title": "Source Authenticity Verified",
      "type": "boolean"
    },
    "spec": {
      "$ref": "#/$defs/PreflightSpec"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/ToolPin"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Tools",
      "type": "array"
    }
  },
  "required": [
    "spec",
    "started_at",
    "finished_at",
    "boot_id",
    "network_namespace_inode",
    "mount_namespace_inode",
    "tools",
    "link",
    "qdiscs",
    "routes"
  ],
  "title": "TrafficPreflight",
  "type": "object"
}
