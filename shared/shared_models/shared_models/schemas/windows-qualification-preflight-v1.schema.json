      "type": "string"
    },
    "target_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Sha256",
      "type": "string"
    }
  },
  "required": [
    "target_sha256",
    "plan_sha256",
    "source_lock_sha256",
    "input_ids"
