      "type": "string"
    },
    "source_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Lock Sha256",
      "type": "string"
    },
    "status": {
      "const": "PREFLIGHT_ONLY_AWAITING_REAL_WINDOWS_OPERATOR",
      "default": "PREFLIGHT_ONLY_AWAITING_REAL_WINDOWS_OPERATOR",
