    },
    "input_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
        "type": "string"
      },
      "maxItems": 100,
      "minItems": 2,
      "title": "Input Ids",
      "type": "array"
    },
    "native_execution_performed": {
      "const": false,
      "default": false,
      "title": "Native Execution Performed",
      "type": "boolean"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "production_execution_qualified": {
      "const": false,
      "default": false,
      "title": "Production Execution Qualified",
      "type": "boolean"
    },
    "schema_version": {
      "const": "cryptoscan.windows-qualification-preflight/v1",
      "default": "cryptoscan.windows-qualification-preflight/v1",
