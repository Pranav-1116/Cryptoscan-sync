            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service Name"
        },
        "service_state": {
          "anyOf": [
            {
              "enum": [
                "active",
                "inactive",
                "activating",
                "deactivating",
                "failed",
                "reloading",
                "maintenance",
                "refreshing",
                "RUNNING",
                "STOPPED",
                "START_PENDING",
                "STOP_PENDING",
                "CONTINUE_PENDING",
                "PAUSE_PENDING",
                "PAUSED"
