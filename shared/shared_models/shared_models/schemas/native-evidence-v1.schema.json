            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hardware Type"
        },
        "identity_key": {
          "maxLength": 300,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Identity Key",
          "type": "string"
        },
        "interface": {
          "enum": [
            "LINUX_PROCFS",
