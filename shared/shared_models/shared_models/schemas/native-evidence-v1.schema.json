            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Firmware Version"
        },
        "hardware_type": {
          "anyOf": [
            {
              "enum": [
                "SYSTEM_DMI",
                "TPM",
                "CPU_TOPOLOGY"
