              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Service State"
        },
        "socket_inode": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Socket Inode"
        },
        "software_name": {
          "default": null,
          "title": "Software Name",
          "type": "null"
        },
        "software_version": {
          "default": null,
          "title": "Software Version",
