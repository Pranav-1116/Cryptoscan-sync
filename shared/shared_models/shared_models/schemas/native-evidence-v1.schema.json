        "interface_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface Sha256"
        },
        "key_size": {
          "default": null,
          "title": "Key Size",
          "type": "null"
        },
        "kind": {
          "enum": [
            "PROCESS",
            "LOADED_LIBRARY",
            "LISTENER",
            "SERVICE",
            "HARDWARE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "library_path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "pattern": "^/[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Library Path"
        },
        "local_basis": {
          "const": "OBSERVED",
          "default": "OBSERVED",
          "title": "Local Basis",
          "type": "string"
        },
        "manufacturer": {
          "anyOf": [
            {
              "maxLength": 120,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manufacturer"
        },
        "mapped_file_deleted": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mapped File Deleted"
        },
        "mapping_basis": {
          "anyOf": [
            {
              "const": "SHARED_OBJECT_PATH_SUFFIX_ONLY",
