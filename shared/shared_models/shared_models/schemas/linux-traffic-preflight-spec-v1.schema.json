{
  "$id": "https://cryptoscan.local/schemas/linux-traffic-preflight-spec-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorizes_real_host_change": {
      "const": false,
      "default": false,
      "title": "Authorizes Real Host Change",
      "type": "boolean"
    },
    "egress_limit_mbps": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Egress Limit Mbps",
      "type": "integer"
    },
    "expected_boot_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Expected Boot Id",
      "type": "string"
    },
    "expected_ifindex": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Expected Ifindex",
      "type": "integer"
    },
    "expected_mount_namespace_inode": {
      "maximum": 18446744073709551615,
      "minimum": 1,
      "title": "Expected Mount Namespace Inode",
      "type": "integer"
    },
    "expected_network_namespace_inode": {
      "maximum": 18446744073709551615,
      "minimum": 1,
      "title": "Expected Network Namespace Inode",
      "type": "integer"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "host_label": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Host Label",
      "type": "string"
    },
    "interface": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,14}$",
      "title": "Interface",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "management_ips": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Management Ips",
      "type": "array"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Nonce",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "proposal_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Record Sha256",
      "type": "string"
    },
    "read_only": {
      "const": true,
      "default": true,
      "title": "Read Only",
      "type": "boolean"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "cryptoscan.linux-traffic-preflight-spec/v1",
      "default": "cryptoscan.linux-traffic-preflight-spec/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_capture_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Capture Sha256",
      "type": "string"
    },
    "system_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "System Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "proposal_id",
    "proposal_record_sha256",
    "source_capture_sha256",
    "nonce",
    "system_id",
    "host_label",
    "interface",
    "expected_ifindex",
    "expected_boot_id",
    "expected_network_namespace_inode",
    "expected_mount_namespace_inode",
    "egress_limit_mbps",
    "management_ips",
    "issued_at",
    "expires_at"
  ],
  "title": "PreflightSpec",
  "type": "object"
}
