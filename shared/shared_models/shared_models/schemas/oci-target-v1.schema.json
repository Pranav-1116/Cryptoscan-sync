{
  "$defs": {
    "ImageInput": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Input Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "DPKG_STATUS",
            "APK_INSTALLED",
            "RPM_SQLITE",
            "LINUX_OS_RELEASE",
            "PUBLIC_CERTIFICATE",
            "BINARY_METADATA",
            "NGINX_TLS_CONFIG"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "kind",
        "path"
      ],
      "title": "ImageInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "architecture": {
      "enum": [
        "amd64",
        "arm64"
      ],
      "title": "Architecture",
      "type": "string"
    },
    "authorization_reference": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Authorization Reference",
      "type": "string"
    },
    "environment": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Environment",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/ImageInput"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "layout_path": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Layout Path",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "not_before": {
      "format": "date-time",
      "title": "Not Before",
      "type": "string"
    },
    "schema_version": {
      "const": "cryptoscan.oci-target/v1",
      "default": "cryptoscan.oci-target/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "system_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "System Id",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Target Id",
      "type": "string"
    }
  },
  "required": [
    "target_id",
    "system_id",
    "environment",
    "authorization_reference",
    "layout_path",
    "manifest_sha256",
    "architecture",
    "not_before",
    "expires_at",
    "inputs"
  ],
  "title": "OciTarget",
  "type": "object"
}
