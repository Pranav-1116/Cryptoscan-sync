{
  "additionalProperties": false,
  "properties": {
    "evidence_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Evidence Ref",
      "type": "string"
    },
    "expected_revision": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Expected Revision",
      "type": "integer"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 20,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "evidence_ref",
    "reason"
  ],
  "title": "OciTruthDecision",
  "type": "object"
}
