{
  "$defs": {
    "OperationApprovalV2": {
      "additionalProperties": false,
      "properties": {
        "application_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Application Id",
          "type": "string"
        },
        "application_log_public_key": {
          "maxLength": 44,
          "minLength": 44,
          "title": "Application Log Public Key",
          "type": "string"
        },
        "approval_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Approval Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "mechanism": {
          "enum": [
            "RSA_PKCS1_SHA256",
            "RSA_PSS_SHA256",
            "ECDSA_P256_SHA256"
          ],
          "title": "Mechanism",
          "type": "string"
        },
        "nonce_hex": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Nonce Hex",
          "type": "string"
        },
        "not_before": {
          "format": "date-time",
          "title": "Not Before",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Operation Id",
          "type": "string"
        },
        "operation_public_key": {
          "maxLength": 4096,
          "minLength": 44,
          "title": "Operation Public Key",
          "type": "string"
        },
        "operation_public_key_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Operation Public Key Sha256",
          "type": "string"
        },
        "provider_key_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Provider Key Id",
          "type": "string"
        },
        "provider_log_public_key": {
          "maxLength": 44,
          "minLength": 44,
          "title": "Provider Log Public Key",
          "type": "string"
        },
        "reviewer_reference": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Reviewer Reference",
          "type": "string"
        },
        "schema_version": {
          "const": "cryptoscan.operation-approval/v2",
          "default": "cryptoscan.operation-approval/v2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "application_id",
        "provider_key_id",
        "operation_id",
        "nonce_hex",
        "application_log_public_key",
        "provider_log_public_key",
        "operation_public_key",
        "mechanism",
        "not_before",
        "expires_at",
        "reviewer_reference",
        "operation_public_key_sha256"
      ],
      "title": "OperationApprovalV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval": {
      "$ref": "#/$defs/OperationApprovalV2"
    },
    "provider": {
      "const": "aws_kms",
      "default": "aws_kms",
      "title": "Provider",
      "type": "string"
    },
    "region": {
      "pattern": "^[a-z]{2}(?:-[a-z]+){1,3}-[0-9]$",
      "title": "Region",
      "type": "string"
    },
    "schema_version": {
      "const": "cryptoscan.hsm-operation-request/v1",
      "default": "cryptoscan.hsm-operation-request/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "region",
    "approval"
  ],
  "title": "HsmOperationRequest",
  "type": "object"
}
