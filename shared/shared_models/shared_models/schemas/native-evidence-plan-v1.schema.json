{
  "$defs": {
    "ExpectedNativeInput": {
      "additionalProperties": false,
      "properties": {
        "facts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Facts",
          "type": "array"
        },
        "input_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
