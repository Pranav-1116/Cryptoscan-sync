{
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "checks": {
      "additionalProperties": {
        "items": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "type": "array"
      },
      "title": "Checks",
      "type": "object"
    },
    "native": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Native",
      "type": "object"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "release_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Release Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "cryptoscan.qualification-index/v1",
      "default": "cryptoscan.qualification-index/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tenant Id"
    }
  },
  "required": [
    "campaign_id",
    "tenant_id",
    "policy_sha256",
    "release_sha256",
    "native",
    "checks"
  ],
  "title": "EvidenceIndex",
  "type": "object"
}
