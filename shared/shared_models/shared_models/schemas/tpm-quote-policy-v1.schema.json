{
  "additionalProperties": false,
  "properties": {
    "ak_public_key_pem": {
      "maxLength": 8192,
      "minLength": 40,
      "title": "Ak Public Key Pem",
      "type": "string"
    },
    "enrollment_reference": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Enrollment Reference",
      "type": "string"
    },
    "host_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Host Id",
      "type": "string"
    },
    "min_clock": {
      "default": 0,
      "maximum": 18446744073709551615,
      "minimum": 0,
      "title": "Min Clock",
      "type": "integer"
    },
    "min_firmware_version": {
      "default": 0,
      "maximum": 18446744073709551615,
      "minimum": 0,
      "title": "Min Firmware Version",
      "type": "integer"
    },
    "pcr_sha256": {
      "additionalProperties": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "maxProperties": 24,
      "minProperties": 1,
      "title": "Pcr Sha256",
      "type": "object"
    },
    "qualified_signer_hex": {
      "pattern": "^000b[0-9a-f]{64}$",
      "title": "Qualified Signer Hex",
      "type": "string"
    },
    "reset_count": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Reset Count",
      "type": "integer"
    },
    "restart_count": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Restart Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "cryptoscan.tpm-quote-policy/v1",
      "default": "cryptoscan.tpm-quote-policy/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tenant Id"
    }
  },
  "required": [
    "host_id",
    "tenant_id",
    "enrollment_reference",
    "ak_public_key_pem",
    "qualified_signer_hex",
    "pcr_sha256",
    "reset_count",
    "restart_count"
  ],
  "title": "QuotePolicy",
  "type": "object"
}
