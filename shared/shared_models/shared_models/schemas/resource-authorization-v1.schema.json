{
  "$defs": {
    "ResourceScope": {
      "additionalProperties": false,
      "properties": {
        "system_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "System Id",
          "type": "string"
        },
        "environment": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Environment",
          "type": "string"
        },
        "host_label": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Host Label",
          "type": "string"
        },
        "interfaces": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,14}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Interfaces",
          "type": "array"
        },
        "mount_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Mount Paths",
          "type": "array"
        },
        "interval_seconds": {
          "default": 5,
          "maximum": 30,
          "minimum": 1,
          "title": "Interval Seconds",
          "type": "integer"
        },
        "not_before": {
          "format": "date-time",
          "title": "Not Before",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "system_id",
        "environment",
        "host_label",
        "interfaces",
        "mount_paths",
        "not_before",
        "expires_at"
      ],
      "title": "ResourceScope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cryptoscan.resource-authorization/v1",
      "default": "cryptoscan.resource-authorization/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Plan Id",
      "type": "string"
    },
    "plan_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Record Sha256",
      "type": "string"
    },
    "scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scope Sha256",
      "type": "string"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Nonce",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ResourceScope"
    },
    "authorizes_remote_execution": {
      "const": false,
      "default": false,
      "title": "Authorizes Remote Execution",
      "type": "boolean"
    },
    "authorizes_packet_capture": {
      "const": false,
      "default": false,
      "title": "Authorizes Packet Capture",
      "type": "boolean"
    },
    "authorizes_configuration_change": {
      "const": false,
      "default": false,
      "title": "Authorizes Configuration Change",
      "type": "boolean"
    }
  },
  "required": [
    "plan_id",
    "plan_record_sha256",
    "scope_sha256",
    "nonce",
    "scope"
  ],
  "title": "ResourceAuthorization",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
