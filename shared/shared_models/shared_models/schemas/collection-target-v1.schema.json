{
  "$defs": {
    "HostInput": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Input Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "PUBLIC_CERTIFICATE",
            "NGINX_TLS_CONFIG",
            "BINARY_METADATA",
            "DPKG_STATUS",
            "WINDOWS_UNINSTALL",
            "LINUX_OS_RELEASE",
            "LINUX_PROCESS",
            "LINUX_PROCESS_MAPS",
            "LINUX_LISTENERS",
            "LINUX_SERVICE",
            "LINUX_HARDWARE",
            "WINDOWS_SERVICE",
            "APK_INSTALLED",
            "RPM_SQLITE",
            "WINDOWS_OS_RELEASE",
            "WINDOWS_CERTIFICATE",
            "WINDOWS_PROCESS_MODULES"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "kind",
        "path"
      ],
      "title": "HostInput",
      "type": "object"
    },
    "HostManifest": {
      "additionalProperties": false,
      "properties": {
        "approval_reference": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Approval Reference",
          "type": "string"
        },
        "environment": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Environment",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "host_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Host Id",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/HostInput"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "max_file_bytes": {
          "default": 1048576,
          "maximum": 1048576,
          "minimum": 1,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 16777216,
          "maximum": 16777216,
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
        },
        "platform": {
          "enum": [
            "linux",
            "windows"
          ],
          "title": "Platform",
          "type": "string"
        },
        "schema_version": {
          "const": "cryptoscan.host-manifest/v1",
          "default": "cryptoscan.host-manifest/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "approval_reference",
        "host_id",
        "environment",
        "platform",
        "expires_at",
        "inputs"
      ],
      "title": "HostManifest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "address": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Address",
      "type": "string"
    },
    "allowed_operations": {
      "items": {
        "const": "READ_APPROVED_METADATA",
        "type": "string"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Allowed Operations",
      "type": "array"
    },
    "collection_method": {
      "enum": [
        "offline_host",
        "windows",
        "container",
        "source",
        "cloud",
        "network",
        "hsm",
        "hardware",
        "vendor",
        "ot"
      ],
      "title": "Collection Method",
      "type": "string"
    },
    "credential_ref": {
      "anyOf": [
        {
          "maxLength": 200,
          "pattern": "^vault://[A-Za-z0-9_./-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Credential Ref"
    },
    "environment": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Environment",
      "type": "string"
    },
    "exclusions": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Exclusions",
      "type": "array"
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/HostManifest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "not_before": {
      "format": "date-time",
      "title": "Not Before",
      "type": "string"
    },
    "owner": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Owner",
      "type": "string"
    },
    "read_only": {
      "const": true,
      "default": true,
      "title": "Read Only",
      "type": "boolean"
    },
    "system_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "System Id",
      "type": "string"
    },
    "target_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Target Key",
      "type": "string"
    }
  },
  "required": [
    "target_key",
    "system_id",
    "owner",
    "environment",
    "collection_method",
    "address",
    "allowed_operations",
    "not_before"
  ],
  "title": "TargetSpec",
  "type": "object"
}
