{
  "$defs": {
    "SnapshotInput": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Input Id",
          "type": "string"
        },
        "kind": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "status": {
          "enum": [
            "PARSED",
            "DENIED",
            "UNSUPPORTED",
            "INVALID",
            "BUDGET_EXCEEDED",
            "UNAVAILABLE"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Reason",
          "type": "string"
        },
        "input_basis": {
          "default": "APPROVED_INPUT",
          "enum": [
            "APPROVED_INPUT",
            "PINNED_IMAGE_CONFIG"
          ],
          "title": "Input Basis",
          "type": "string"
        },
        "asset_absence_proven": {
          "const": false,
          "default": false,
          "title": "Asset Absence Proven",
          "type": "boolean"
        }
      },
      "required": [
        "input_id",
        "kind",
        "path",
        "status",
        "reason"
      ],
      "title": "SnapshotInput",
      "type": "object"
    },
    "SnapshotObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "identity_slot": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Identity Slot",
          "type": "string"
        },
        "identity_basis": {
          "const": "SCOPED_METADATA_SLOT_NOT_ATTESTED_ASSET",
          "default": "SCOPED_METADATA_SLOT_NOT_ATTESTED_ASSET",
          "title": "Identity Basis",
          "type": "string"
        },
        "input_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Input Id",
          "type": "string"
        },
        "fact_kind": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Fact Kind",
          "type": "string"
        },
        "fact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fact Sha256",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "provenance": {
          "const": "IMPORTED",
          "default": "IMPORTED",
          "title": "Provenance",
          "type": "string"
        },
        "local_basis": {
          "enum": [
            "OBSERVED",
            "DECLARED",
            "IMPORTED",
            "INFERRED",
            "UNKNOWN"
          ],
          "title": "Local Basis",
          "type": "string"
        },
        "domains": {
          "items": {
            "enum": [
              "SBOM",
              "CBOM",
              "NBOM",
              "HBOM",
              "VBOM",
              "TechBOM"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Domains",
          "type": "array"
        }
      },
      "required": [
        "observation_id",
        "identity_slot",
        "input_id",
        "fact_kind",
        "fact_sha256",
        "evidence_id",
        "local_basis",
        "domains"
      ],
      "title": "SnapshotObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "cryptoscan.collection-snapshot/v1",
      "default": "cryptoscan.collection-snapshot/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "family": {
      "enum": [
        "host",
        "oci"
      ],
      "title": "Family",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Job Id",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Target Id",
      "type": "string"
    },
    "system_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "System Id",
      "type": "string"
    },
    "environment": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Environment",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/SnapshotInput"
      },
      "maxItems": 101,
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/SnapshotObservation"
      },
      "maxItems": 1001,
      "title": "Observations",
      "type": "array"
    },
    "whole_asset_coverage_verified": {
      "const": false,
      "default": false,
      "title": "Whole Asset Coverage Verified",
      "type": "boolean"
    },
    "source_authenticity_verified": {
      "const": false,
      "default": false,
      "title": "Source Authenticity Verified",
      "type": "boolean"
    },
    "runtime_use": {
      "const": "UNKNOWN",
      "default": "UNKNOWN",
      "title": "Runtime Use",
      "type": "string"
    },
    "production_execution_qualified": {
      "const": false,
      "default": false,
      "title": "Production Execution Qualified",
      "type": "boolean"
    }
  },
  "required": [
    "family",
    "job_id",
    "target_id",
    "system_id",
    "environment",
    "source_sha256",
    "started_at",
    "finished_at",
    "inputs",
    "observations"
  ],
  "title": "CollectionSnapshot",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
