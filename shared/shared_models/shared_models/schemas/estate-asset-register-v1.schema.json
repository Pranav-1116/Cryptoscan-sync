{
  "$defs": {
    "EstateAsset": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Asset Id",
          "type": "string"
        },
        "platform": {
          "enum": [
            "linux",
            "windows",
            "container",
            "application",
            "appliance"
          ],
          "title": "Platform",
          "type": "string"
        },
        "producer_public_key": {
          "maxLength": 44,
          "minLength": 44,
          "title": "Producer Public Key",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "platform",
        "producer_public_key"
      ],
      "title": "EstateAsset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/EstateAsset"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "estate_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Estate Id",
      "type": "string"
    },
    "register_reference": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Register Reference",
      "type": "string"
    }
  },
  "required": [
    "estate_id",
    "register_reference",
    "assets"
  ],
  "title": "EstateAssetRegister",
  "type": "object"
}
