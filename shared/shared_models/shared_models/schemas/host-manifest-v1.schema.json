{
  "$defs": {
    "HostInput": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Input Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "PUBLIC_CERTIFICATE",
            "NGINX_TLS_CONFIG",
            "BINARY_METADATA",
            "DPKG_STATUS",
            "WINDOWS_UNINSTALL",
            "LINUX_OS_RELEASE",
            "LINUX_PROCESS",
            "LINUX_PROCESS_MAPS",
            "LINUX_LISTENERS",
            "LINUX_SERVICE",
            "LINUX_HARDWARE",
            "WINDOWS_SERVICE",
            "APK_INSTALLED"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "kind",
        "path"
      ],
      "title": "HostInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_reference": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Approval Reference",
      "type": "string"
    },
    "environment": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Environment",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "host_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Host Id",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/HostInput"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "max_file_bytes": {
      "default": 1048576,
      "maximum": 1048576,
      "minimum": 1,
      "title": "Max File Bytes",
      "type": "integer"
    },
    "max_total_bytes": {
      "default": 16777216,
      "maximum": 16777216,
      "minimum": 1,
      "title": "Max Total Bytes",
      "type": "integer"
    },
    "platform": {
      "enum": [
        "linux",
        "windows"
      ],
      "title": "Platform",
      "type": "string"
    },
    "schema_version": {
      "const": "cryptoscan.host-manifest/v1",
      "default": "cryptoscan.host-manifest/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "approval_reference",
    "host_id",
    "environment",
    "platform",
    "expires_at",
    "inputs"
  ],
  "title": "HostManifest",
  "type": "object"
}
