{
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Job Id",
      "type": "string"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Nonce",
      "type": "string"
    },
    "schema_version": {
      "const": "cryptoscan.oci-capture-binding/v1",
      "default": "cryptoscan.oci-capture-binding/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Target Id",
      "type": "string"
    },
    "target_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Record Sha256",
      "type": "string"
    },
    "target_revision": {
      "maximum": 100,
      "minimum": 2,
      "title": "Target Revision",
      "type": "integer"
    },
    "target_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Sha256",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "target_id",
    "target_revision",
    "target_record_sha256",
    "target_sha256",
    "nonce",
    "issued_at",
    "expires_at"
  ],
  "title": "OciCaptureBinding",
  "type": "object"
}
