{
  "$id": "https://cryptoscan.local/schemas/linux-traffic-change-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "duration_seconds": {
      "maximum": 5,
      "minimum": 1,
      "title": "Duration Seconds",
      "type": "integer"
    },
    "expected_preflight_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Preflight Record Sha256",
      "type": "string"
    },
    "preflight_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Preflight Id",
      "type": "string"
    },
    "reason": {
      "maxLength": 500,
      "minLength": 20,
      "title": "Reason",
      "type": "string"
    },
    "reviewer_user_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Reviewer User Id",
      "type": "string"
    }
  },
  "required": [
    "preflight_id",
    "expected_preflight_record_sha256",
    "reviewer_user_id",
    "duration_seconds",
    "reason"
  ],
  "title": "ValidationChange",
  "type": "object"
}
