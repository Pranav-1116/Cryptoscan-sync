{
  "$defs": {
    "ExpectedImageInput": {
      "additionalProperties": false,
      "properties": {
        "expected_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Content Sha256",
          "type": "string"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/HostFact"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Facts",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/ImageInput"
        }
      },
      "required": [
        "source",
        "expected_content_sha256",
        "facts"
      ],
      "title": "ExpectedImageInput",
      "type": "object"
    },
    "HostFact": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "default": "UNKNOWN",
          "enum": [
            "RSA",
            "EC",
            "DSA",
            "ED25519",
            "ED448",
            "UNKNOWN"
          ],
          "title": "Algorithm",
          "type": "string"
        },
        "binary_format": {
          "default": "UNKNOWN",
          "enum": [
            "ELF",
            "PE",
            "UNKNOWN"
          ],
          "title": "Binary Format",
          "type": "string"
        },
        "certificate_signature_oid": {
          "default": "UNKNOWN",
          "maxLength": 100,
          "pattern": "^(UNKNOWN|[0-9]+(?:\\.[0-9]+)+)$",
          "title": "Certificate Signature Oid",
          "type": "string"
        },
        "cipher_suites": {
          "items": {
            "enum": [
              "AES128-GCM-SHA256",
              "AES256-GCM-SHA384",
              "ECDHE-RSA-AES128-GCM-SHA256",
              "ECDHE-RSA-AES256-GCM-SHA384",
              "ECDHE-ECDSA-AES128-GCM-SHA256",
              "ECDHE-ECDSA-AES256-GCM-SHA384"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "title": "Cipher Suites",
          "type": "array"
        },
        "curve": {
          "default": "UNKNOWN",
          "enum": [
            "secp256r1",
            "secp384r1",
            "secp521r1",
            "UNKNOWN"
          ],
          "title": "Curve",
          "type": "string"
        },
        "fingerprint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint Sha256"
        },
        "key_size": {
          "anyOf": [
            {
              "maximum": 16384,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Size"
        },
        "kind": {
          "enum": [
            "CERTIFICATE",
            "TLS_CONFIGURATION",
            "BINARY",
            "SOFTWARE",
            "OS_RELEASE"
          ],
          "title": "Kind",
          "type": "string"
        },
        "local_basis": {
          "enum": [
            "OBSERVED",
            "DECLARED"
          ],
          "title": "Local Basis",
          "type": "string"
        },
        "mode": {
          "const": "UNKNOWN",
          "default": "UNKNOWN",
          "title": "Mode",
          "type": "string"
        },
        "policy_result": {
          "const": "NOT_EVALUATED",
          "default": "NOT_EVALUATED",
          "title": "Policy Result",
          "type": "string"
        },
        "pqc_assessment": {
          "const": "UNKNOWN",
          "default": "UNKNOWN",
          "title": "Pqc Assessment",
          "type": "string"
        },
        "protocols": {
          "items": {
            "enum": [
              "TLSv1",
              "TLSv1.1",
              "TLSv1.2",
              "TLSv1.3"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Protocols",
          "type": "array"
        },
        "purpose": {
          "enum": [
            "PUBLIC_KEY_METADATA",
            "TLS_CONFIGURATION",
            "FILE_PRESENCE",
            "PACKAGE_DATABASE_RECORD",
            "OS_RELEASE_METADATA"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "runtime_use": {
          "const": "UNKNOWN",
          "default": "UNKNOWN",
          "title": "Runtime Use",
          "type": "string"
        },
        "signature_hash": {
          "default": "UNKNOWN",
          "enum": [
            "SHA1",
            "SHA224",
            "SHA256",
            "SHA384",
            "SHA512",
            "UNKNOWN"
          ],
          "title": "Signature Hash",
          "type": "string"
        },
        "software_name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Software Name"
        },
        "software_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Software Version"
        },
        "unparsed_directives": {
          "default": false,
          "title": "Unparsed Directives",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "local_basis",
        "purpose"
      ],
      "title": "HostFact",
      "type": "object"
    },
    "ImageInput": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
          "title": "Input Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "DPKG_STATUS",
            "APK_INSTALLED",
            "RPM_SQLITE",
            "LINUX_OS_RELEASE",
            "PUBLIC_CERTIFICATE",
            "BINARY_METADATA",
            "NGINX_TLS_CONFIG"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "input_id",
        "kind",
        "path"
      ],
      "title": "ImageInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected": {
      "items": {
        "$ref": "#/$defs/ExpectedImageInput"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Expected",
      "type": "array"
    },
    "expected_job_revision": {
      "default": 1,
      "maximum": 1,
      "minimum": 1,
      "title": "Expected Job Revision",
      "type": "integer"
    },
    "reviewer_user_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Reviewer User Id",
      "type": "string"
    },
    "schema_version": {
      "const": "cryptoscan.oci-truth-proposal/v1",
      "default": "cryptoscan.oci-truth-proposal/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_reference": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Source Reference",
      "type": "string"
    },
    "target_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Record Sha256",
      "type": "string"
    },
    "target_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Sha256",
      "type": "string"
    }
  },
  "required": [
    "target_sha256",
    "target_record_sha256",
    "reviewer_user_id",
    "source_reference",
    "expected"
  ],
  "title": "OciTruthProposal",
  "type": "object"
}
