          "type": "string"
        },
        "identity_key": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Identity Key",
          "type": "string"
        },
        "image_path": {
          "maxLength": 1024,
          "minLength": 4,
          "title": "Image Path",
          "type": "string"
        },
        "interface": {
          "const": "WINDOWS_PROCESS_TOOLHELP",
          "default": "WINDOWS_PROCESS_TOOLHELP",
          "title": "Interface",
          "type": "string"
        },
        "interface_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Interface Sha256",
          "type": "string"
        },
        "key_size": {
          "default": null,
          "title": "Key Size",
          "type": "null"
        },
