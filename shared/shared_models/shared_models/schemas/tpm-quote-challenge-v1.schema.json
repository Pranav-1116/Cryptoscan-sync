{
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "challenge_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Challenge Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "host_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Host Id",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Nonce",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "cryptoscan.tpm-quote-challenge/v1",
      "default": "cryptoscan.tpm-quote-challenge/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Sha256",
      "type": "string"
    },
    "source_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Lock Sha256",
      "type": "string"
    },
    "target_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Sha256",
      "type": "string"
    },
    "tenant_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tenant Id"
    },
    "worker_claim_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Worker Claim Sha256",
      "type": "string"
    }
  },
  "required": [
    "challenge_id",
    "nonce",
    "campaign_id",
    "host_id",
    "tenant_id",
    "policy_sha256",
    "target_sha256",
    "source_lock_sha256",
    "snapshot_sha256",
    "worker_claim_sha256",
    "issued_at",
    "expires_at"
  ],
  "title": "QuoteChallenge",
  "type": "object"
}
