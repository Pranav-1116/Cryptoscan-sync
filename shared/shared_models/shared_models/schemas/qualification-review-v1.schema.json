{
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Campaign Id",
      "type": "string"
    },
    "checks": {
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL",
          "NOT_RUN"
        ],
        "type": "string"
      },
      "title": "Checks",
      "type": "object"
    },
    "decision": {
      "enum": [
        "ACCEPT_SCOPED_EVIDENCE",
        "REJECT"
      ],
      "title": "Decision",
      "type": "string"
    },
    "evidence_reference": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Evidence Reference",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "index_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Index Sha256",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "release_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Release Sha256",
      "type": "string"
    },
    "reviewer_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+ ~()\\[\\]-]{0,119}$",
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "cryptoscan.qualification-review/v1",
      "default": "cryptoscan.qualification-review/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "signed_at": {
      "format": "date-time",
      "title": "Signed At",
      "type": "string"
    },
    "tenant_id": {
      "anyOf": [
        {
          "maxLength": 36,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Tenant Id"
    }
  },
  "required": [
    "reviewer_id",
    "campaign_id",
    "tenant_id",
    "policy_sha256",
    "release_sha256",
    "index_sha256",
    "decision",
    "checks",
    "evidence_reference",
    "signed_at",
    "expires_at"
  ],
  "title": "ReviewStatement",
  "type": "object"
}
