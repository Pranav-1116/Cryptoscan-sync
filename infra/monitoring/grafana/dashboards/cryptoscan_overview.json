      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" } },
      "targets": [
        { "expr": "increase(cryptoscan_findings_total[1h])", "legendFormat": "new findings /h", "refId": "A" },
        { "expr": "increase(cryptoscan_scans_total[1h])", "legendFormat": "new scans /h", "refId": "B" }
