{
  "dashboard": {
    "title": "CryptoScan Real Product — Deterministic No AI",
    "panels": [
      {
        "title": "p99 Latency — Real-Time System — Target <500ms",
        "type": "graph",
        "targets": [{"expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))"}],
        "alert": {"conditions": [{"evaluator": {"params": [0.5], "type": "gt"}}]}
      },
      {
        "title": "Throughput — 100K+ events/sec",
        "type": "graph",
        "targets": [{"expr": "rate(realtime_messages_total[5m])"}]
      },
      {
        "title": "Active WebSocket Connections",
        "type": "graph",
        "targets": [{"expr": "realtime_active_connections"}]
      },
      {
        "title": "CDT Simulations — Real Engine",
        "type": "graph",
        "targets": [{"expr": "rate(cdt_simulations_total[5m])"}]
      },
      {
        "title": "Evidence Chain Verification",
        "type": "stat",
        "targets": [{"expr": "evidence_chain_verification_failed"}]
      },
      {
        "title": "QRNG Entropy",
        "type": "graph",
        "targets": [{"expr": "qrng_entropy_avail"}, {"expr": "qrng_shannon_entropy"}]
      },
      {
        "title": "Risk Scoring — CRITICAL/HIGH/MEDIUM/LOW",
        "type": "piechart",
        "targets": [{"expr": "sum by (category) (risk_findings_total)"}]
      },
      {
        "title": "Compliance — PASS/FAIL per Standard",
        "type": "table",
        "targets": [{"expr": "compliance_status"}]
      }
    ]
  }
}
