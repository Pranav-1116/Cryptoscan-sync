{
  "schema": "cryptoscan.readiness-closure-policy/1",
  "version": 1,
  "description": "Evidence requirements for closing the documented enterprise-bank P0/P1 gaps. This policy defines what must be supplied; it does not create customer, provider, auditor, legal, regulatory, or production evidence.",
  "gaps": [
    {
      "id": "P0-1",
      "priority": "P0",
      "title": "Independent security assessment and penetration test",
      "owner": "security-leadership",
      "required_kinds": ["independent_security_assessment"],
      "minimum_tier": "operational_record",
      "max_age_days": 365
    },
    {
      "id": "P0-2",
      "priority": "P0",
      "title": "Real customer pilot and field-accuracy validation",
      "owner": "product-security",
      "required_kinds": ["customer_pilot_validation"],
      "minimum_tier": "customer_attestation",
      "max_age_days": 365
    },
    {
      "id": "P0-3",
      "priority": "P0",
      "title": "Certified cryptographic boundary and real HSM qualification",
      "owner": "cryptography-security",
      "required_kinds": ["hsm_provider_qualification", "hsm_provider_attestation"],
      "minimum_tier": "operational_record",
      "max_age_days": 365
    },
    {
      "id": "P0-4",
      "priority": "P0",
      "title": "Production-grade disaster recovery and business continuity",
      "owner": "sre-operations",
      "required_kinds": ["topology_dr_drill", "continuity_plan_approval"],
      "minimum_tier": "operational_record",
      "max_age_days": 90
    },
    {
      "id": "P0-5",
      "priority": "P0",
      "title": "Immutable, verifiable software supply chain",
      "owner": "platform-release",
      "required_kinds": ["signed_release_bundle", "deployment_admission_record"],
      "minimum_tier": "operational_record",
      "max_age_days": 30
    },
    {
      "id": "P0-6",
      "priority": "P0",
      "title": "Formal vulnerability, patch, and incident-management program",
      "owner": "security-operations",
      "required_kinds": ["approved_operational_policy", "vulnerability_program_record"],
      "minimum_tier": "operational_record",
      "max_age_days": 365
    },
    {
      "id": "P0-7",
      "priority": "P0",
      "title": "Bank-grade identity, privileged access, and separation of duties",
      "owner": "identity-security",
      "required_kinds": ["identity_integration_qualification", "access_review_record"],
      "minimum_tier": "operational_record",
      "max_age_days": 90
    },
    {
      "id": "P0-8",
      "priority": "P0",
      "title": "Data protection, privacy, residency, and exit controls",
      "owner": "privacy-legal",
      "required_kinds": ["data_protection_residency_package", "exit_deletion_verification"],
      "minimum_tier": "customer_attestation",
      "max_age_days": 365
    },
    {
      "id": "P0-9",
      "priority": "P0",
      "title": "Contractual and support readiness",
      "owner": "commercial-operations",
      "required_kinds": ["approved_support_contract", "support_escalation_exercise"],
      "minimum_tier": "customer_attestation",
      "max_age_days": 365
    },
    {
      "id": "P1-1",
      "priority": "P1",
      "title": "Regulatory and control-framework mapping",
      "owner": "compliance",
      "required_kinds": ["jurisdiction_control_mapping"],
      "minimum_tier": "customer_attestation",
      "max_age_days": 365
    },
    {
      "id": "P1-2",
      "priority": "P1",
      "title": "Availability, scalability, and soak evidence",
      "owner": "sre-operations",
      "required_kinds": ["target_topology_load_soak"],
      "minimum_tier": "operational_record",
      "max_age_days": 180
    },
    {
      "id": "P1-3",
      "priority": "P1",
      "title": "Production observability and security operations",
      "owner": "security-operations",
      "required_kinds": ["observability_tabletop"],
      "minimum_tier": "operational_record",
      "max_age_days": 180
    },
    {
      "id": "P1-4",
      "priority": "P1",
      "title": "Integration qualification in the bank environment",
      "owner": "solutions-engineering",
      "required_kinds": ["customer_environment_integration"],
      "minimum_tier": "customer_attestation",
      "max_age_days": 365
    },
    {
      "id": "P1-5",
      "priority": "P1",
      "title": "Secure product lifecycle and change governance",
      "owner": "engineering-security",
      "required_kinds": ["secure_change_governance_record"],
      "minimum_tier": "operational_record",
      "max_age_days": 365
    }
  ]
}
