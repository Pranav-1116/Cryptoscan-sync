digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.50", ranksep="0.65", fontname="Arial", fontsize=18, labelloc=t, label="04 | End-to-end disaster recovery and controlled cutover"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.30,0.18", penwidth=1.2];
edge [fontname="Arial", fontsize=10, color="#536577", arrowsize=0.7];
"incident" [label="Declare incident / disaster\nrecord T0, scope, legal estate and decision owner", fillcolor="#fff1cf", color="#9c7019"];
"fence" [label="Contain and fence old writers / runtimes\nclose admissions; disable schedules / egress\npreserve host / queue / audit evidence", fillcolor="#def4ec", color="#25705b"];
"choose" [label="Select last known-good consistent cohort\ncompare external ACK / incident ledger\nchoose PITR target before corruption if available", fillcolor="#fff1cf", color="#9c7019"];
"infra" [label="Build clean isolated recovery infrastructure\nDNS / routing isolated, storage, TLS / CA\ntrusted recovery identities and key quorum", fillcolor="#def4ec", color="#25705b"];
"verify" [label="Verify release + backup provenance\ntrusted out-of-band fingerprints\nartifact checksums + key decryptability", fillcolor="#def4ec", color="#25705b"];
"restore" [label="Restore SQL + matched evidence / source / config\nrestore required Redis under separate policy\nno producers / workers enabled yet", fillcolor="#e5f0ff", color="#2f5c91"];
"integrity" [label="Offline invariants and scope checks\nschema, owner links, chain / manifest verification\nidentity revocations and tombstones reconciled", fillcolor="#def4ec", color="#25705b"];
"reconcile" [label="Reconcile SQL jobs / attempts / budgets / outbox\nidentify UNKNOWN external work; fence again\nrestore is not execution permission", fillcolor="#def4ec", color="#25705b"];
"replay" [label="Redis role-specific reconciliation\nrotate epoch / reject stale cursors\nrenew authentication / invalidate stale state as required", fillcolor="#def4ec", color="#25705b"];
"smoke" [label="Restricted API / UI smoke and negative tests\nreadiness, auth, A/B/platform isolation\ncurrent proof, source and cleanup checks", fillcolor="#def4ec", color="#25705b"];
"approve" [label="Different reviewer + incident / service owner\naccept measured loss and service limitations\nrecord explicit cutover approval", fillcolor="#fff1cf", color="#9c7019"];
"cutover" [label="Controlled single-writer traffic cutover\nprogressive admission; only approved new work\nmonitor dependencies and current proof", fillcolor="#def4ec", color="#25705b"];
"failback" [label="Stabilize then separately approve failback\nreplicate all new writes; fence former active side\nno old backup rollback after accepting new writes", fillcolor="#fff1cf", color="#9c7019"];
"stop" [label="STOP / retain isolation\nquarantine, remediate or choose another cohort", fillcolor="#ffe6e6", color="#a84646"];
"incident" -> "fence" [label="authorized response"];
"fence" -> "choose" [label="old side accounted for"];
"choose" -> "infra" [label="approved recovery point"];
"infra" -> "verify" [label="custody available"];
"verify" -> "restore" [label="compatible authenticated artifacts"];
"restore" -> "integrity" [label="data loaded"];
"integrity" -> "reconcile" [label="required invariants pass"];
"reconcile" -> "replay" [label="execution outcomes accounted for"];
"replay" -> "smoke" [label="consumer state accounted for"];
"smoke" -> "approve" [label="results + RPO / RTO"];
"approve" -> "cutover" [label="explicit decision"];
"cutover" -> "failback" [label="stable recovery operations"];
"verify" -> "stop" [label="trust / decrypt failure"];
"integrity" -> "stop" [label="missing / inconsistent evidence"];
"reconcile" -> "stop" [label="unresolved effect blocks admission"];
"smoke" -> "stop" [label="critical negative fails"];
}
