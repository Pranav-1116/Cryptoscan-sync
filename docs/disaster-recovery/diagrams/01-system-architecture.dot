digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.50", ranksep="0.65", fontname="Arial", fontsize=18, labelloc=t, label="01 | Production authority, failure domains and recovery dependencies"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.30,0.18", penwidth=1.2];
edge [fontname="Arial", fontsize=10, color="#536577", arrowsize=0.7];
"human" [label="Authorized bank users\ncurrent human sessions / selected estate", fillcolor="#def4ec", color="#25705b"];
"edge" [label="Bank DNS + HTTPS ingress\nfrontend :3003 / same-origin API proxy", fillcolor="#fff1cf", color="#9c7019"];
"api" [label="API service :8010\nauthority, assurance and operator reads", fillcolor="#def4ec", color="#25705b"];
"sql" [label="Regional PostgreSQL + verified TLS\nidentity, six-BOM metadata, evidence/blobs\njobs, attempts, budgets, outbox, immutable history", fillcolor="#e5f0ff", color="#2f5c91"];
"redis" [label="Regional verified-TLS Redis\n8 inventoried consumer roles\ntransport/replay is not SQL authority", fillcolor="#e5f0ff", color="#2f5c91"];
"worker" [label="Dedicated trusted dispatcher / worker\ncurrent admission + fenced claim\nDocker daemon is root-equivalent", fillcolor="#def4ec", color="#25705b"];
"src" [label="Approved source PVC\nread-only to API / worker\nexact owner, admitted root and content identity", fillcolor="#e5f0ff", color="#2f5c91"];
"stage" [label="Private same-path staging on runtime host\ntransient; inspect or quarantine on incident", fillcolor="#eef0f4", color="#687381"];
"parser" [label="Digest-pinned isolated parser\nnetwork disabled; no DB / Redis credentials\nno daemon socket", fillcolor="#def4ec", color="#25705b"];
"files" [label="Declared durable file / object stores\nraw SBOMs, admitted exports and attachments\nonly if present in approved deployment", fillcolor="#e5f0ff", color="#2f5c91"];
"secrets" [label="Separate bank key / secret / PKI custody\nCAs, ingress TLS, recovery and signing trust", fillcolor="#fff1cf", color="#9c7019"];
"release" [label="Trusted offline / replicated release inventory\nAPI + worker + parser + frontend digests\nexternally verified attestation", fillcolor="#fff1cf", color="#9c7019"];
"observe" [label="Restricted monitoring + incident / ACK ledger\nindependent failure domain", fillcolor="#fff1cf", color="#9c7019"];
"vault" [label="Encrypted immutable backup copy\nseparate credentials, approved location\nSQL + objects + required Redis + manifests", fillcolor="#fff1cf", color="#9c7019"];
"dr" [label="Isolated recovery estate\nold writers fenced; egress / admission closed\nnot an automatically provisioned standby", fillcolor="#fff1cf", color="#9c7019"];
"optional" [label="Other profiles only\nNeo4j, local bus / live-CBOM files, extra collectors\ndisabled or separately qualified", fillcolor="#eef0f4", color="#687381"];
"human" -> "edge" [label="HTTPS"];
"edge" -> "api" [label="same-origin /api"];
"api" -> "sql" [label="owner-scoped\ntransactions"];
"api" -> "redis" [label="role-specific\noperations"];
"worker" -> "sql" [label="claim / checkpoints\nresults + outbox"];
"worker" -> "redis" [label="queue hints\nleases"];
"src" -> "api" [label="approved input\nreferences"];
"src" -> "worker" [label="admitted content"];
"worker" -> "stage" [label="bounded staging"];
"stage" -> "parser" [label="read-only staged input"];
"worker" -> "parser" [label="bounded launch / cleanup"];
"parser" -> "worker" [label="bounded results; worker persists"];
"api" -> "files" [label="declared raw artifact bindings"];
"secrets" -> "api" [label="authorized runtime\ninjection"];
"secrets" -> "worker" [label="authorized runtime\ninjection"];
"release" -> "dr" [label="verified compatible images"];
"sql" -> "vault" [label="consistent encrypted backup"];
"files" -> "vault" [label="versioned consistent cohort"];
"redis" -> "vault" [label="separate approved persistence"];
"vault" -> "dr" [label="verified restore only"];
"secrets" -> "dr" [label="separate recovery quorum"];
"sql" -> "observe" [label="restricted telemetry / markers"];
"worker" -> "observe" [label="outcome / cleanup\nevidence"];
"optional" -> "vault" [label="conditional inventory; never assume N/A", style="dashed"];
}
