digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.50", ranksep="0.65", fontname="Arial", fontsize=18, labelloc=t, label="08 | Drill evidence, measured objectives and recovery acceptance"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.30,0.18", penwidth=1.2];
edge [fontname="Arial", fontsize=10, color="#536577", arrowsize=0.7];
"scope" [label="Agree scenario / topology / release / estate\nRPO, RTO, loss, load and retention objectives\noperators, witness, abort and containment", fillcolor="#fff1cf", color="#9c7019"];
"seed" [label="Record independent pre-fault markers / ACKs\ninclude valid, denied, stale and UNKNOWN cases\nretain expected IDs and clock sources", fillcolor="#e5f0ff", color="#2f5c91"];
"fault" [label="Approved fault in disposable / authorized scope\nhost / disk / DB / Redis / keys / corruption\nnever point destructive lab at customer services", fillcolor="#def4ec", color="#25705b"];
"recover" [label="Execute isolated recovery / failback procedure\nrecord every gate, timestamp and deviation\nno falsified completion or manual hash repair", fillcolor="#def4ec", color="#25705b"];
"measure" [label="Compare same pre-fault IDs and invariants\nactual loss + measured service RTO + throughput\nA/B/platform isolation, evidence and current proof", fillcolor="#def4ec", color="#25705b"];
"record" [label="Restricted raw evidence + report\ncommands, logs, release hashes, operator / witness\nfailures, skips, exclusions and lost IDs", fillcolor="#e5f0ff", color="#2f5c91"];
"review" [label="Different entitled reviewer / bank authority\naccept or reject exact scenario and candidate\nseparate technical and customer decisions", fillcolor="#fff1cf", color="#9c7019"];
"accepted" [label="Bounded accepted evidence + expiry\nrevalidate on topology / release / key / policy change\nnot automatic 24x7 staffing or SLA", fillcolor="#def4ec", color="#25705b"];
"blocked" [label="BLOCKED / NOT EXECUTED / FAIL\nretain adverse result, remediate and retest\nnever convert SKIP or plan into PASS", fillcolor="#ffe6e6", color="#a84646"];
"scope" -> "seed" [label="authorized measurable test"];
"seed" -> "fault" [label="independent baseline retained"];
"fault" -> "recover" [label="incident clock starts per agreed definition"];
"recover" -> "measure" [label="recorded service / data results"];
"measure" -> "record" [label="raw evidence, not only label"];
"record" -> "review" [label="exact source / scenario binding"];
"review" -> "accepted" [label="all required checks accepted"];
"scope" -> "blocked" [label="missing authorization / environment"];
"recover" -> "blocked" [label="unsafe or failed recovery"];
"measure" -> "blocked" [label="loss / invariants / objectives fail"];
"review" -> "blocked" [label="missing or rejected review"];
"accepted" -> "scope" [label="material change / expiry"];
}
