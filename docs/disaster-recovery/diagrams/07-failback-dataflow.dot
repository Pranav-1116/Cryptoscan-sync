digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.50", ranksep="0.65", fontname="Arial", fontsize=18, labelloc=t, label="07 | Failback without discarding recovery-site writes"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.30,0.18", penwidth=1.2];
edge [fontname="Arial", fontsize=10, color="#536577", arrowsize=0.7];
"active" [label="Recovery site is current single writer\nnew business writes and evidence are authoritative", fillcolor="#e5f0ff", color="#2f5c91"];
"prepare" [label="Build clean replacement original site\nrepair root cause, restore trust and compatibility\nkeep old compromised disks quarantined", fillcolor="#def4ec", color="#25705b"];
"sync" [label="Copy current recovery-side state\nSQL positions + file versions + consumer plan\ninclude every post-cutover write", fillcolor="#def4ec", color="#25705b"];
"validate" [label="Validate catch-up and consistency cohort\ncompare external ACK / evidence markers\nrehearse negative and recovery gates", fillcolor="#fff1cf", color="#9c7019"];
"freeze" [label="Approve brief producer quiesce\naccount for attempts; final synchronization\nfence recovery-side writers before promotion", fillcolor="#def4ec", color="#25705b"];
"switch" [label="Single-writer controlled traffic switch\nrebind endpoints / current credentials / Redis epoch\nprogressive admission + telemetry", fillcolor="#def4ec", color="#25705b"];
"observe" [label="Observe agreed stability interval\nmeasure loss, errors, latency and current proof\nkeep rollback choice explicit", fillcolor="#fff1cf", color="#9c7019"];
"close" [label="Close incident only after review\narchive evidence; expire old access / copies\nrepeat backup and second recovery drill", fillcolor="#def4ec", color="#25705b"];
"abort" [label="Before new-site writes: remain on recovery site\nAfter new-site writes: reconcile forward\nnever overwrite new data with an older backup", fillcolor="#ffe6e6", color="#a84646"];
"active" -> "prepare" [label="authorized failback planning"];
"prepare" -> "sync" [label="compatible clean target"];
"active" -> "sync" [label="authoritative new state"];
"sync" -> "validate" [label="catch-up markers"];
"validate" -> "freeze" [label="all required checks pass"];
"freeze" -> "switch" [label="final sync + positive fencing evidence"];
"switch" -> "observe" [label="controlled writes resume"];
"observe" -> "close" [label="accepted measured result"];
"validate" -> "abort" [label="gap / incompatibility"];
"freeze" -> "abort" [label="cannot prove fencing / catch-up"];
"observe" -> "abort" [label="regression; account for all new writes"];
}
