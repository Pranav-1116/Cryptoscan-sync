digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.50", ranksep="0.65", fontname="Arial", fontsize=18, labelloc=t, label="05 | Restored SQL execution authority and UNKNOWN handling"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.30,0.18", penwidth=1.2];
edge [fontname="Arial", fontsize=10, color="#536577", arrowsize=0.7];
"hint" [label="Restored / duplicate Redis delivery\nor SQL outbox publication", fillcolor="#eef0f4", color="#687381"];
"lookup" [label="Load exact-estate SQL job\nreconcile post-backup effects + current grant\nmissing outcome knowledge blocks admission\ntransport is not authority", fillcolor="#def4ec", color="#25705b"];
"queued" [label="QUEUED + current eligible grant\ntransactional attempt / budget claim", fillcolor="#e5f0ff", color="#2f5c91"];
"running" [label="RUNNING / unresolved old attempt\nnever automatically resume or duplicate", fillcolor="#fff1cf", color="#9c7019"];
"terminal" [label="Terminal job / stale / foreign hint\nno execution and no victim mutation", fillcolor="#ffe6e6", color="#a84646"];
"parser" [label="Newly claimed bounded parser operation\ncheckpoints + cleanup + durable result", fillcolor="#def4ec", color="#25705b"];
"unknown" [label="UNKNOWN / ambiguous outcome\nfenced old attempt; both reservations held\nno timeout-means-stopped assumption", fillcolor="#ffe6e6", color="#a84646"];
"evidence" [label="Establish old process / effects stopped\nretain host, SQL, queue and external evidence", fillcolor="#def4ec", color="#25705b"];
"human" [label="Authorized selected-estate administrator\nCAS reconciliation receipt + evidence\nCONFIRMED_STOPPED or CONFIRMED_COMPLETED", fillcolor="#fff1cf", color="#9c7019"];
"settled" [label="Original job FAILED / reconciled\nrelease each reservation once\nno fabricated scan or COMPLETED job", fillcolor="#e5f0ff", color="#2f5c91"];
"new" [label="Optional NEW job / current approval\nnew identity, allowance and admission\nnever turn old job back into QUEUED", fillcolor="#def4ec", color="#25705b"];
"complete" [label="Confirmed durable normal completion\nretain actual owned result / receipts", fillcolor="#e5f0ff", color="#2f5c91"];
"hint" -> "lookup" [label="read-back"];
"lookup" -> "queued" [label="eligible QUEUED only"];
"lookup" -> "running" [label="already in flight"];
"lookup" -> "terminal" [label="refused / terminal"];
"queued" -> "parser" [label="new fenced claim"];
"parser" -> "complete" [label="confirmed durable completion"];
"parser" -> "unknown" [label="unconfirmed result / cleanup"];
"running" -> "unknown" [label="deadline fencing / ambiguity"];
"unknown" -> "evidence" [label="operator investigation"];
"evidence" -> "human" [label="independent stop / outcome evidence"];
"human" -> "settled" [label="authorized one-time settlement"];
"settled" -> "new" [label="optional new approved request"];
"new" -> "lookup" [label="normal admission again"];
}
