digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.50", ranksep="0.65", fontname="Arial", fontsize=18, labelloc=t, label="06 | Recovery trust, keys and ransomware isolation"];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.30,0.18", penwidth=1.2];
edge [fontname="Arial", fontsize=10, color="#536577", arrowsize=0.7];
"prod" [label="Production runtime identities\nleast privilege; no backup-delete or key-export rights", fillcolor="#def4ec", color="#25705b"];
"capture" [label="Scoped backup operator / service\nread approved stores; encrypt to approved recipient\nrestricted temporary plaintext", fillcolor="#def4ec", color="#25705b"];
"vault" [label="Independent immutable / offline copy\napproved residency + version retention\nseparate administration and delete policy", fillcolor="#e5f0ff", color="#2f5c91"];
"catalog" [label="Independent manifest / audit custody\ntrusted signature and clean-point markers\nnot modifiable by runtime account", fillcolor="#e5f0ff", color="#2f5c91"];
"keys" [label="Separate recovery-key custodians\nquorum / break glass under incident approval\nHSM / KMS method must actually be tested", fillcolor="#fff1cf", color="#9c7019"];
"trust" [label="Out-of-band public trust fingerprints\nrelease and backup-signing authorities\nkey validity / revocation at recovery time", fillcolor="#fff1cf", color="#9c7019"];
"ir" [label="Incident / forensic preservation\nquarantine compromised hosts and credentials\nselect point before corruption", fillcolor="#ffe6e6", color="#a84646"];
"clean" [label="Clean isolated recovery identities / hosts\nrotate compromised credentials; revoke stale sessions\nretain required historical verification material", fillcolor="#def4ec", color="#25705b"];
"restore" [label="Authorized restore operator + separate reviewer\nverify provenance, keys, bytes and invariants\nno general-access plaintext or secret export", fillcolor="#def4ec", color="#25705b"];
"delete" [label="Retention / legal-hold decision authority\nauthorized deletion across copies and keys\nrestore must not resurrect revoked rights", fillcolor="#fff1cf", color="#9c7019"];
"prod" -> "capture" [label="approved capture channel"];
"capture" -> "vault" [label="encrypted append / protected transfer"];
"capture" -> "catalog" [label="manifest and copy receipts"];
"keys" -> "capture" [label="recipient / authorized encryption reference"];
"vault" -> "restore" [label="candidate copy only"];
"catalog" -> "restore" [label="independent authenticity / completeness"];
"keys" -> "restore" [label="separately authorized decryption"];
"trust" -> "restore" [label="verify trusted authority"];
"ir" -> "clean" [label="clean rebuild and rotation"];
"clean" -> "restore" [label="restricted recovery boundary"];
"ir" -> "catalog" [label="incident / compromise time markers"];
"delete" -> "vault" [label="approved lifecycle; no runtime delete rights"];
"delete" -> "keys" [label="key retention / destruction review"];
}
