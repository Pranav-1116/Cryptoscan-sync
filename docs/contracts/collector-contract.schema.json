{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cryptoscan.collector-contract/1",
  "title": "CryptoScan collector standard contract",
  "description": "Published contract every discovery collector conforms to (gap analysis §D). Two objects: the publishable descriptor (who the collector is, what it may touch, how its code is signed) and the per-run report (what it did, against which scope, with what evidence and coverage). A zero-asset run must carry one of the four named zero_reasons; an unexplained zero is not a measurement.",
  "x-module": "shared_models.collector_contract",
  "x-gap-analysis-fields": [
    "collector identity and version",
    "supported asset types",
    "required permissions",
    "collection start/end time",
    "target scope",
    "success, partial, refused or failed state",
    "evidence references",
    "coverage metrics",
    "data sensitivity classification",
    "signature or integrity metadata"
  ],
  "$defs": {
    "sensitivity": {
      "type": "string",
      "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
    },
    "run_state": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "REFUSED", "FAILED"]
    },
    "zero_reason": {
      "type": "string",
      "enum": ["FOUND_NOTHING", "NO_PERMISSION", "FAILED", "UNSUPPORTED_TARGET"]
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "oneOf": [
    {
      "title": "collector descriptor",
      "type": "object",
      "required": [
        "schema", "collector_id", "version", "supported_asset_types",
        "required_permissions", "data_sensitivity", "signature"
      ],
      "properties": {
        "schema": { "const": "cryptoscan.collector-contract/1" },
        "collector_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "supported_asset_types": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_permissions": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "data_sensitivity": { "$ref": "#/$defs/sensitivity" },
        "signature": { "$ref": "#/$defs/signature" }
      },
      "additionalProperties": true
    },
    {
      "title": "collection run report",
      "type": "object",
      "required": [
        "schema", "collector_id", "version", "started_at", "ended_at",
        "target_scope", "state", "assets_found", "asset_count",
        "evidence_ids", "coverage_metrics", "data_sensitivity",
        "zero_reason", "report_digest"
      ],
      "properties": {
        "schema": { "const": "cryptoscan.collector-contract/1" },
        "collector_id": { "type": "string" },
        "version": { "type": "string" },
        "started_at": { "type": "string", "minLength": 1 },
        "ended_at": { "type": "string", "minLength": 1 },
        "target_scope": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/run_state" },
        "assets_found": { "type": "array" },
        "asset_count": { "type": "integer", "minimum": 0 },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "coverage_metrics": { "type": "object" },
        "data_sensitivity": { "$ref": "#/$defs/sensitivity" },
        "zero_reason": {
          "oneOf": [
            { "$ref": "#/$defs/zero_reason" },
            { "type": "null" }
          ]
        },
        "note": { "type": ["string", "null"] },
        "report_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    }
  ]
}
