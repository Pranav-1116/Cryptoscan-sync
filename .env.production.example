# CryptoScan PRODUCTION template.
# Copy to .env on the production host and fill every required value.
# Do not use development defaults. Do not copy another project's dotenv.

ENVIRONMENT=production
LOG_LEVEL=INFO
DOCS_ENABLED=false
COOKIE_SECURE=true
ALLOW_SQLITE=false
ALLOW_INSECURE_CORS=false

# Public origin list (comma-separated). Never "*".
CORS_ORIGINS=https://cryptoscan.example.com
# JSON host allow-list consumed by Starlette TrustedHostMiddleware.
TRUSTED_HOSTS=["cryptoscan.example.com"]

# openssl rand -hex 32 — Prometheus bearer token for /metrics
METRICS_TOKEN=
# openssl rand -hex 32 — Alertmanager's credential for /ops/alerts/alertmanager.
# Must differ from METRICS_TOKEN: one is a read credential, one authorises a write.
ALERTMANAGER_WEBHOOK_TOKEN=

# Monitoring sidecar (docker-compose.monitoring.yml). Render the two token files
# with `python3 scripts/render_monitoring_secrets.py` before starting the stack.
MONITORING_SECRETS_DIR=./infra/monitoring/secrets
PROMETHEUS_IMAGE=prometheus/prometheus:v2.53.2
ALERTMANAGER_IMAGE=prometheus/alertmanager:v0.27.0
PROMETHEUS_RETENTION=15d
PROMETHEUS_EXTERNAL_URL=http://prometheus:9090

# openssl rand -hex 32
SECRET_KEY=

# python3 scripts/hash_admin_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
REGISTRY_WEBHOOK_SECRET=
CBOM_SIGNING_SECRET=
STREAM_SECRET=
AUDITOR_API_KEY=

# Migration/ownership account only. PostgreSQL's POSTGRES_USER is a superuser.
POSTGRES_USER=cryptoscan
POSTGRES_PASSWORD=
POSTGRES_DB=cryptoscan
# Bank DBA provisions a separate LOGIN role with NOSUPERUSER and NOBYPASSRLS,
# grants runtime table/sequence permissions AFTER applying migrations, then
# supplies this URL privately. Never reuse POSTGRES_USER or its password here.
CRYPTOSCAN_APP_DATABASE_URL=
# The governance database-backup API writes encrypted dumps here. Must already
# exist on a bank-managed persistent mount writable by the API uid (10001).
# This is distinct from the optional SBOM_STORAGE_BACKUP_DIR declaration;
# a directory alone never proves an independent backup or a restore drill.
BACKUP_STORAGE_HOST_PATH=
# Full-estate PostgreSQL backups require a separate bank-operated backup
# service with its own DBA-reviewed identity; never give BYPASSRLS credentials
# to the API process or call an API-side pg_dump a bank recovery plan.
# OFF by default. Only after a reviewed recovery change: designate an isolated
# database distinct from the signed backup's source. No UI restore action exists.
# This name check alone is not an operator approval or a qualified restore drill.
CRYPTOSCAN_RESTORE_TARGET_DB=

# Required durable realtime journal/shared scan state. Production refuses to boot without it.
# Provision a named least-privilege ACL user and a CA-verified TLS service.
# URL-encode the password; do not disable certificate/hostname verification.
REDIS_URL=rediss://replay:REPLACE_WITH_URL_ENCODED_SECRET@redis.internal:6379/0
REDIS_CA_CERTS=/run/secrets/redis-ca.pem
REDIS_CA_HOST_PATH=
# Optional Sentinel routing for realtime journal + current-run state only.
# All Sentinel and discovered data endpoints need verified TLS.
REDIS_SENTINELS=
# Example: [["sentinel-a.internal",26379],["sentinel-b.internal",26379],["sentinel-c.internal",26379]]
REDIS_SENTINEL_MASTER=
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=
EVENT_TAILER_SECONDS=2

# Optional docker-compose.s3.yml: bank-owned, TLS S3/MinIO for sealed BOM bytes.
# Provision a non-root identity with only the versioned artifact bucket's
# probe/tenant-object operations. These paths are bind-mounted read-only to
# API and worker, never passed as a secret value or exposed to migration.
# Do not enable this overlay for the loopback-only local MinIO test service;
# a container cannot reach the host's 127.0.0.1-bound socket as its own loopback.
SBOM_S3_ENDPOINT=
SBOM_S3_BUCKET=
SBOM_S3_REGION=us-east-1
SBOM_S3_ACCESS_KEY_HOST_PATH=
SBOM_S3_SECRET_KEY_HOST_PATH=
SBOM_S3_CA_HOST_PATH=
# A declared backup path and period alone do not prove independent copies,
# Object Lock/WORM, disaster recovery or bank-site qualification.
SBOM_STORAGE_BACKUP_DIR=
SBOM_RETENTION_DAYS=

# The 24/7 estate loop. Leave disabled and run the dedicated `estate-daemon`
# Compose service (or `cryptoscan serve`) — one loop per platform is enough, and
# the runs are lease-protected either way. Enable this only for a single-process
# install that has no second supervisor.
ESTATE_REALTIME=0
ESTATE_REALTIME_POLL_SECONDS=30

NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Dependency-graph projections: Cassandra (edge history) and Elasticsearch
# (dependency search). Rebuildable from PostgreSQL, which stays authoritative.
# Empty contact points / URL disables the store; reads report the gap rather
# than serving a fabricated timeline or search result. Use *_FILE secrets in
# production; the store refuses linked, oversized or malformed files.
CASSANDRA_CONTACT_POINTS=
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=cryptoscan_graph
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
# CASSANDRA_PASSWORD_FILE=
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=cryptoscan-dependency-graph
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
# ELASTICSEARCH_PASSWORD_FILE=

# Host publish for nginx only. Databases stay on the compose network.
NGINX_PORT=80

SCAN_JOB_QUEUE_KEY=cryptoscan:jobs:queue
CRYPTOSCAN_CVE_LIVE=0
CRYPTOSCAN_TLS_LIVE=0
CRYPTOSCAN_CLOUD_LIVE=0
CRYPTOSCAN_CLOUD_SUBMIT=0
CRYPTOSCAN_CBOM_SIGN=0

# Static source-parser boundary only (see docs/dev/scanner-isolation.md).
# Blank mode selects inline in development/test, container in production.
# Production refuses inline and requires a preloaded, digest-pinned image.
# A Docker CLI/approved daemon and same-path shared staging are additional
# prerequisites; these variables alone do not provision an isolated runtime.
CRYPTOSCAN_STATIC_SCAN_MODE=
CRYPTOSCAN_SCANNER_IMAGE=
CRYPTOSCAN_STATIC_SCAN_TIMEOUT_S=600

# Optional dedicated notification scheduler (Compose profile: notifications).
# OFF until explicitly enabled AND estates selected; no SMTP or automatic opt-in.
# Tenant IDs must be a JSON list of registered active tenant UUIDs. Region must
# match declared processing_regions (or data_residency_region when unspecified).
NOTIFICATION_DISPATCH_ENABLED=false
NOTIFICATION_DISPATCH_PLATFORM=false
NOTIFICATION_DISPATCH_TENANTS=[]
NOTIFICATION_DISPATCH_REGION=
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=30
NOTIFICATION_DISPATCH_BUDGET_SECONDS=20
NOTIFICATION_DISPATCH_SCOPE_BUDGET_SECONDS=5
NOTIFICATION_DISPATCH_MAX_SCOPES=10
NOTIFICATION_DISPATCH_LIMIT=50
