# CryptoScan PRODUCTION template.
# Copy to .env on the production host and fill every required value.
# Do not use development defaults. Do not copy another project's dotenv.

ENVIRONMENT=production
LOG_LEVEL=INFO
DOCS_ENABLED=false
COOKIE_SECURE=true
ALLOW_SQLITE=false
ALLOW_INSECURE_CORS=false

# Public origin list (comma-separated). Never "*".
CORS_ORIGINS=https://cryptoscan.example.com
# JSON host allow-list consumed by Starlette TrustedHostMiddleware.
TRUSTED_HOSTS=["cryptoscan.example.com"]

# openssl rand -hex 32 — Prometheus bearer token for /metrics
METRICS_TOKEN=
ALERTMANAGER_WEBHOOK_TOKEN=

# openssl rand -hex 32
SECRET_KEY=

# python3 scripts/hash_admin_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
REGISTRY_WEBHOOK_SECRET=
CBOM_SIGNING_SECRET=
STREAM_SECRET=
AUDITOR_API_KEY=

POSTGRES_USER=cryptoscan
POSTGRES_PASSWORD=
POSTGRES_DB=cryptoscan

# Required durable realtime journal/shared scan state. Production refuses to boot without it.
# Provision a named least-privilege ACL user and a CA-verified TLS service.
# URL-encode the password; do not disable certificate/hostname verification.
REDIS_URL=rediss://replay:REPLACE_WITH_URL_ENCODED_SECRET@redis.internal:6379/0
REDIS_CA_CERTS=/run/secrets/redis-ca.pem
# Optional Sentinel routing for realtime journal + current-run state only.
# All Sentinel and discovered data endpoints need verified TLS.
REDIS_SENTINELS=
# Example: [["sentinel-a.internal",26379],["sentinel-b.internal",26379],["sentinel-c.internal",26379]]
REDIS_SENTINEL_MASTER=
REDIS_SENTINEL_USERNAME=
REDIS_SENTINEL_PASSWORD=
EVENT_TAILER_SECONDS=2

# The 24/7 estate loop. Leave disabled and run the dedicated `estate-daemon`
# Compose service (or `cryptoscan serve`) — one loop per platform is enough, and
# the runs are lease-protected either way. Enable this only for a single-process
# install that has no second supervisor.
ESTATE_REALTIME=0
ESTATE_REALTIME_POLL_SECONDS=30

NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Host publish for nginx only. Databases stay on the compose network.
NGINX_PORT=80

SCAN_JOB_QUEUE_KEY=cryptoscan:jobs:queue
CRYPTOSCAN_CVE_LIVE=0
CRYPTOSCAN_TLS_LIVE=0
CRYPTOSCAN_CLOUD_LIVE=0
CRYPTOSCAN_CLOUD_SUBMIT=0
CRYPTOSCAN_CBOM_SIGN=0

# Static source-parser boundary only (see docs/dev/scanner-isolation.md).
# Blank mode selects inline in development/test, container in production.
# Production refuses inline and requires a preloaded, digest-pinned image.
# A Docker CLI/approved daemon and same-path shared staging are additional
# prerequisites; these variables alone do not provision an isolated runtime.
CRYPTOSCAN_STATIC_SCAN_MODE=
CRYPTOSCAN_SCANNER_IMAGE=
CRYPTOSCAN_STATIC_SCAN_TIMEOUT_S=600

# Optional dedicated notification scheduler (Compose profile: notifications).
# OFF until explicitly enabled AND estates selected; no SMTP or automatic opt-in.
# Tenant IDs must be a JSON list of registered active tenant UUIDs. Region must
# match declared processing_regions (or data_residency_region when unspecified).
NOTIFICATION_DISPATCH_ENABLED=false
NOTIFICATION_DISPATCH_PLATFORM=false
NOTIFICATION_DISPATCH_TENANTS=[]
NOTIFICATION_DISPATCH_REGION=
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=30
NOTIFICATION_DISPATCH_BUDGET_SECONDS=20
NOTIFICATION_DISPATCH_SCOPE_BUDGET_SECONDS=5
NOTIFICATION_DISPATCH_MAX_SCOPES=10
NOTIFICATION_DISPATCH_LIMIT=50
