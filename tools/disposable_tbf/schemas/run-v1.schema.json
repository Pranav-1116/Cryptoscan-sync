{
  "$defs": {
    "CappedTrial": {
      "additionalProperties": false,
      "properties": {
        "after_measurement": {
          "additionalProperties": true,
          "title": "After Measurement",
          "type": "object"
        },
        "applied": {
          "additionalProperties": true,
          "title": "Applied",
          "type": "object"
        },
        "measurement": {
          "$ref": "#/$defs/Measurement"
        },
        "rate_mbps": {
          "enum": [
            10,
            5
          ],
          "title": "Rate Mbps",
          "type": "integer"
        },
        "restored_policy": {
          "additionalProperties": true,
          "title": "Restored Policy",
          "type": "object"
        }
      },
      "required": [
        "rate_mbps",
        "applied",
        "after_measurement",
        "measurement",
        "restored_policy"
      ],
      "title": "CappedTrial",
      "type": "object"
    },
    "GuestCapture": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/Measurement"
        },
        "baseline_policy": {
          "additionalProperties": true,
          "title": "Baseline Policy",
          "type": "object"
        },
        "caps": {
          "items": {
            "$ref": "#/$defs/CappedTrial"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Caps",
          "type": "array"
        },
        "final_policy": {
          "additionalProperties": true,
          "title": "Final Policy",
          "type": "object"
        },
        "guest_monotonic_finished_ns": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Guest Monotonic Finished Ns",
          "type": "integer"
        },
        "interface": {
          "const": "lo",
          "title": "Interface",
          "type": "string"
        },
        "kernel_release": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Kernel Release",
          "type": "string"
        },
        "nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Nonce",
          "type": "string"
        },
        "restored": {
          "$ref": "#/$defs/Measurement"
        },
        "rollback_verified": {
          "title": "Rollback Verified",
          "type": "boolean"
        },
        "schema_version": {
          "const": "cryptoscan.disposable-tbf-guest/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "nonce",
        "kernel_release",
        "interface",
        "baseline_policy",
        "baseline",
        "caps",
        "restored",
        "final_policy",
        "rollback_verified",
        "guest_monotonic_finished_ns"
      ],
      "title": "GuestCapture",
      "type": "object"
    },
    "Measurement": {
      "additionalProperties": false,
      "properties": {
        "attempted_packets_total": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Attempted Packets Total",
          "type": "integer"
        },
        "elapsed_ns": {
          "maximum": 6000000000,
          "minimum": 3800000000,
          "title": "Elapsed Ns",
          "type": "integer"
        },
        "invalid_packets": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Invalid Packets",
          "type": "integer"
        },
        "payload_bytes": {
          "const": 1200,
          "title": "Payload Bytes",
          "type": "integer"
        },
        "receive_errors": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Receive Errors",
          "type": "integer"
        },
        "received_bytes": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Received Bytes",
          "type": "integer"
        },
        "received_packets": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Received Packets",
          "type": "integer"
        },
        "send_backpressure": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Send Backpressure",
          "type": "integer"
        },
        "send_errors": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Send Errors",
          "type": "integer"
        },
        "sent_packets_total": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Sent Packets Total",
          "type": "integer"
        },
        "warmup_seconds": {
          "const": 1,
          "title": "Warmup Seconds",
          "type": "integer"
        }
      },
      "required": [
        "received_packets",
        "received_bytes",
        "elapsed_ns",
        "sent_packets_total",
        "send_backpressure",
        "attempted_packets_total",
        "send_errors",
        "receive_errors",
        "invalid_packets",
        "payload_bytes",
        "warmup_seconds"
      ],
      "title": "Measurement",
      "type": "object"
    },
    "ParentContext": {
      "additionalProperties": false,
      "properties": {
        "boot_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Boot Id",
          "type": "string"
        },
        "mount_namespace_inode": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Mount Namespace Inode",
          "type": "integer"
        },
        "network_namespace_inode": {
          "maximum": 18446744073709551615,
          "minimum": 1,
          "title": "Network Namespace Inode",
          "type": "integer"
        }
      },
      "required": [
        "boot_id",
        "network_namespace_inode",
        "mount_namespace_inode"
      ],
      "title": "ParentContext",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "authorizes_real_host_change": {
          "const": false,
          "default": false,
          "title": "Authorizes Real Host Change",
          "type": "boolean"
        },
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "independent_change_approval_verified": {
          "const": false,
          "default": false,
          "title": "Independent Change Approval Verified",
          "type": "boolean"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "nonce": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Nonce",
          "type": "string"
        },
        "profile": {
          "const": "DISKLESS_TCG_NO_NIC_V1",
          "default": "DISKLESS_TCG_NO_NIC_V1",
          "title": "Profile",
          "type": "string"
        },
        "schema_version": {
          "const": "cryptoscan.disposable-tbf-scope/v1",
          "default": "cryptoscan.disposable-tbf-scope/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_label": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.-]+$",
          "title": "Target Label",
          "type": "string"
        }
      },
      "required": [
        "target_label",
        "nonce",
        "bundle_sha256",
        "issued_at",
        "expires_at"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Failure"
    },
    "guest": {
      "anyOf": [
        {
          "$ref": "#/$defs/GuestCapture"
        },
        {
          "type": "null"
        }
      ]
    },
    "host_wall_seconds": {
      "exclusiveMinimum": 0,
      "maximum": 181,
      "title": "Host Wall Seconds",
      "type": "number"
    },
    "parent_after": {
      "$ref": "#/$defs/ParentContext"
    },
    "parent_before": {
      "$ref": "#/$defs/ParentContext"
    },
    "production_execution_qualified": {
      "const": false,
      "title": "Production Execution Qualified",
      "type": "boolean"
    },
    "report": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Report"
    },
    "schema_version": {
      "const": "cryptoscan.disposable-tbf-run/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scope Sha256",
      "type": "string"
    },
    "serial_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Serial Sha256",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "VERIFIED_IN_DISPOSABLE_VM",
        "INCONCLUSIVE_OR_FAILED"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "scope_sha256",
    "bundle_sha256",
    "serial_sha256",
    "host_wall_seconds",
    "parent_before",
    "parent_after",
    "guest",
    "report",
    "failure",
    "production_execution_qualified",
    "verdict"
  ],
  "title": "RunReceipt",
  "type": "object"
}
