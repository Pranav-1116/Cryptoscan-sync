{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorizes_real_host_change": {
      "const": false,
      "default": false,
      "title": "Authorizes Real Host Change",
      "type": "boolean"
    },
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "independent_change_approval_verified": {
      "const": false,
      "default": false,
      "title": "Independent Change Approval Verified",
      "type": "boolean"
    },
    "issued_at": {
      "format": "date-time",
      "title": "Issued At",
      "type": "string"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Nonce",
      "type": "string"
    },
    "profile": {
      "const": "DISKLESS_TCG_NO_NIC_V1",
      "default": "DISKLESS_TCG_NO_NIC_V1",
      "title": "Profile",
      "type": "string"
    },
    "schema_version": {
      "const": "cryptoscan.disposable-tbf-scope/v1",
      "default": "cryptoscan.disposable-tbf-scope/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_label": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+$",
      "title": "Target Label",
      "type": "string"
    }
  },
  "required": [
    "target_label",
    "nonce",
    "bundle_sha256",
    "issued_at",
    "expires_at"
  ],
  "title": "Scope",
  "type": "object"
}
