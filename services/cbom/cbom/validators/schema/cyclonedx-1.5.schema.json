{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CryptoScan CycloneDX 1.5 CBOM subset",
  "type": "object",
  "required": ["bomFormat", "specVersion", "components"],
  "properties": {
    "bomFormat": { "const": "CycloneDX" },
    "specVersion": { "enum": ["1.4", "1.5", "1.6"] },
    "version": { "type": "integer" },
    "serialNumber": { "type": "string" },
    "metadata": { "type": "object" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "cryptoProperties"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "bom-ref": { "type": ["string", "null"] },
          "cryptoProperties": { "type": "object" }
        }
      }
    },
    "vulnerabilities": { "type": "array" },
    "dependencies": { "type": "array" }
  }
}
