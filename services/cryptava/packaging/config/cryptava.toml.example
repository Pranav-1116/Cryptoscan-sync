# /etc/cryptava/cryptava.toml — Cryptava host agent configuration.
# No secrets belong here: the agent's identity and keys live in /var/lib/cryptava (0700).
# Any key can be overridden with an environment variable CRYPTAVA_<KEY>.

# The CryptoScan console this agent reports to.
server = "https://cryptoscan.bank.example"
# CA bundle that signs the console's TLS certificate (the bank's internal CA).
# ca_file = "/etc/pki/tls/certs/bank-internal-ca.pem"

# Which estate this host belongs to (one console can hold several).
estate = "meridian"

# Seconds between full collections; heartbeats keep the agent "online" in between.
interval = 3600
heartbeat_interval = 60
# Seconds between live performance samples for Performance Intelligence -> Live systems
# (CPU, memory, disk, network, TLS handshake time); 0 turns them off.
performance_interval = 60
# auto | host (whole machine) | workload (only the processes of the server beside this agent)
performance_scope = "auto"
# host:port of an HSM to time (TLS connect + first response), e.g. "10.0.4.20:1792"
# hsm_probe = ""
jitter = 120

# Probe this host's own listeners (TLS handshake, SSH banner, PostgreSQL SSLRequest).
# Probes connect to this machine only. Exclude ports that must never be touched.
probe_listeners = true
probe_exclude_ports = []

# Extra places to look for certificates and Java archives.
cert_dirs = []
# jar_dirs = ["/opt", "/srv", "/app"]

# The server's CMDB record: hardware identity (HBOM, where firmware tables are hidden)
# and vendor contracts (VBOM). JSON — see cryptava/register.py. Default path:
# asset_record = "/etc/cryptava/asset-record.json"

[tags]
environment = "prod"
datacenter = "dc1"
owner = "Payments Platform"

# Optional: the bank-approved business mapping for this host (TechBOM).
# Sent as CONFIGURED evidence with an APPROVED_MAPPING basis — never presented as observed.
# [system]
# name = "SWIFT Gateway"
# owner = "Payments Operations"
# criticality = "tier-0"
# [[system.applications]]
# name = "Alliance Access"
# services = ["java", "nginx"]
